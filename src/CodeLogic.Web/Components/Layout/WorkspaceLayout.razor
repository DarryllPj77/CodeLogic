@inherits LayoutComponentBase

@* The Playground draws its own header, panels, and status bar so the whole viewport can be one
   non-scrolling IDE surface. Other pages keep MainLayout and normal page scrolling. *@
<a class="workspace-skip-link" href="#code-editor">Skip to the code editor</a>

@Body

<div id="blazor-error-ui" role="alert" aria-live="assertive">
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error message">×</button>
</div>
