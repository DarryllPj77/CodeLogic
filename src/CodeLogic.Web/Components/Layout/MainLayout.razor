@inherits LayoutComponentBase

<div class="site-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="/playground" aria-label="Open CodeLogic workspace">
                <span class="brand__mark" aria-hidden="true">&lt;/&gt;</span>
                <span class="brand__name">CodeLogic</span>
            </a>

            <NavMenu />

            <div class="toolbar-actions" aria-label="Analysis actions">
                <a class="toolbar-action toolbar-action--primary" href="/playground#code-editor"><span aria-hidden="true">▶</span> Analyze code</a>
                <a class="toolbar-action" href="/playground#flowchart-title">Generate flowchart</a>
                <a class="toolbar-action" href="/playground#trace-title">Run simulation</a>
            </div>

            <div class="toolbar-utilities" aria-label="Workspace utilities">
                <a href="/playground#workspace-settings" aria-label="Workspace settings" title="Workspace settings">⚙</a>
                <AuthorizeView>
                    <Authorized>
                        <span class="profile-chip" title="@context.User.Identity?.Name">@ProfileInitial(context.User.Identity?.Name)</span>
                    </Authorized>
                    <NotAuthorized>
                        <a class="profile-chip" href="/account/login" aria-label="Sign in" title="Sign in">?</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <main id="main-content" class="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="status-bar">
        <span><span class="status-dot" aria-hidden="true"></span> Ready</span>
        <span>Deterministic analysis · No arbitrary .NET execution</span>
    </footer>
</div>

@code {
    private static string ProfileInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();
}

<div id="blazor-error-ui" role="alert" aria-live="assertive">
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error message">×</button>
</div>
