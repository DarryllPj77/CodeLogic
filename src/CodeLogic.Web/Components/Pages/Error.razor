@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong | CodeLogic</PageTitle>

<section class="page-header" role="alert" aria-labelledby="error-title">
    <p class="eyebrow">Application error</p>
    <h1 id="error-title">Something went wrong.</h1>
    <p>CodeLogic could not complete this request. Return home and try the action again.</p>
    <a class="button button--primary" href="/">Return home</a>
</section>

@if (ShowRequestId)
{
    <p class="request-id">
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<details class="developer-details">
    <summary>Information for local development</summary>
    <p>
        The Development environment can display more detailed error information. It must not be enabled in a deployed application because details may contain sensitive information.
    </p>
</details>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
