@page "/lessons/{LessonSlug}"
@inject ICurriculumCatalog CurriculumCatalog
@inject SessionLearningProgressStore ProgressStore

@if (ReadingContext is null)
{
    <PageTitle>Lesson unavailable | CodeLogic</PageTitle>

    <section class="empty-state" aria-labelledby="lesson-unavailable-title">
        <div class="empty-state__mark" aria-hidden="true">?</div>
        <div>
            <p class="eyebrow">Lesson unavailable</p>
            <h1 id="lesson-unavailable-title">We could not find that complete lesson.</h1>
            <p>The address may be incorrect, or the lesson may still be a draft.</p>
            <a class="button button--primary" href="/lessons">Return to lessons</a>
        </div>
    </section>
}
else
{
    <PageTitle>@ReadingContext.Current.Lesson.Title | CodeLogic</PageTitle>

    <HeadContent>
        <meta name="description" content="@ReadingContext.Current.Lesson.Objective" />
    </HeadContent>

    <nav class="lesson-breadcrumb" aria-label="Breadcrumb">
        <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/lessons">Lessons</a></li>
            <li aria-current="page">@ReadingContext.Topic.Title</li>
        </ol>
    </nav>

    <article class="lesson-reading">
        <header class="lesson-reading__header">
            <div class="lesson-reading__meta">
                <span class="status-badge">@ReadingContext.Current.StatusLabel</span>
                <span>Lesson @ReadingContext.Current.Order · @ReadingContext.Current.DifficultyLabel</span>
            </div>
            <h1>@ReadingContext.Current.Lesson.Title</h1>
            <p class="lesson-reading__objective">
                <strong>Learning objective:</strong> @ReadingContext.Current.Lesson.Objective
            </p>
            <div class="button-row">
                <a class="button button--primary" href="#practice-preview">Preview practice</a>
                <a class="button button--secondary" href="/lessons">All lessons</a>
            </div>
        </header>

        <div class="lesson-reading__layout">
            <div class="lesson-reading__content">
                @foreach (var section in ReadingContext.Current.Lesson.Sections)
                {
                    <section class="lesson-content-section" aria-labelledby="section-@section.Order">
                        <p class="lesson-content-section__number">Section @section.Order</p>
                        <h2 id="section-@section.Order">@section.Heading</h2>
                        <p>@section.Content</p>
                    </section>
                }

                <section class="lesson-code" aria-labelledby="sample-code-title">
                    <p class="eyebrow">Code example</p>
                    <h2 id="sample-code-title">Trace this sample</h2>
                    <pre aria-label="Sample C# code for @ReadingContext.Current.Lesson.Title"><code>@ReadingContext.Current.SampleCode</code></pre>
                    <p>
                        This sample belongs to the declared safe subset. CodeLogic displays it as learning content and does not execute it.
                    </p>
                </section>

                <section id="practice-preview" class="practice-preview" aria-labelledby="practice-preview-title">
                    <p class="eyebrow">Practice</p>
                    <h2 id="practice-preview-title">@ReadingContext.Current.Exercise.Title</h2>
                    <p>@ReadingContext.Current.Exercise.Prompt</p>
                    <p><strong>This checks:</strong> @ReadingContext.Current.QuizCriteria.AssessmentGoal</p>

                    <form class="quiz-form" method="post" action="/lessons/@ReadingContext.Slug/quiz">
                        <AntiforgeryToken />
                        @if (ReadingContext.Current.QuizCriteria.ResponseKind == QuizResponseKind.MultipleChoice)
                        {
                            <fieldset>
                                <legend>Choose one answer</legend>
                                <div class="quiz-options">
                                    @for (var index = 0; index < ReadingContext.Current.QuizCriteria.AnswerOptions.Count; index++)
                                    {
                                        var option = ReadingContext.Current.QuizCriteria.AnswerOptions[index];
                                        var optionId = $"quiz-option-{index}";
                                        <label class="quiz-option" for="@optionId">
                                            <input id="@optionId"
                                                   type="radio"
                                                   name="answer"
                                                   value="@option"
                                                   required />
                                            <span>@option</span>
                                        </label>
                                    }
                                </div>
                            </fieldset>
                        }
                        else
                        {
                            <label class="quiz-input-label" for="quiz-answer">Your answer</label>
                            <input id="quiz-answer"
                                   class="quiz-input"
                                   type="text"
                                   name="answer"
                                   maxlength="100"
                                   autocomplete="off"
                                   required />
                        }

                        <button class="button button--primary" type="submit">Check answer</button>
                    </form>

                    @if (EvaluationResult is not null)
                    {
                        <div class="quiz-feedback @FeedbackClass" role="status" aria-live="polite">
                            <h3>@FeedbackHeading</h3>
                            <p>@EvaluationResult.Feedback</p>
                            @if (EvaluationResult.Explanation is not null)
                            {
                                <p><strong>Why:</strong> @EvaluationResult.Explanation</p>
                            }
                        </div>

                        @if (EvaluationResult.IsCorrect)
                        {
                            <p><a class="text-link" href="/progress">View your updated session progress →</a></p>
                        }
                    }

                    <p class="quiz-privacy-note">Answers are compared as text. Attempt outcomes and lesson completion remain only in this temporary browser session.</p>
                </section>
            </div>

            <aside class="lesson-reading__sidebar" aria-labelledby="lesson-status-title">
                <section class="completion-stub">
                    <p class="status-badge">@(IsLessonComplete ? "Complete this session" : "Not complete")</p>
                    <h2 id="lesson-status-title">@(IsLessonComplete ? "Lesson completed" : "Finish the practice")</h2>
                    <p>
                        @(IsLessonComplete
                            ? "A correct attempt completed this lesson for the current session."
                            : "Submit a correct practice answer to complete this lesson for the current session.")
                    </p>
                    <a class="text-link" href="/progress">View session progress</a>
                </section>

                <section class="safe-concepts" aria-labelledby="safe-concepts-title">
                    <h2 id="safe-concepts-title">Safe concepts in this lesson</h2>
                    <ul>
                        @foreach (var concept in ReadingContext.Current.AllowedConcepts)
                        {
                            <li>@FormatConcept(concept)</li>
                        }
                    </ul>
                </section>
            </aside>
        </div>
    </article>

    <nav class="lesson-pagination" aria-label="Lesson navigation">
        @if (ReadingContext.Previous is not null)
        {
            <a class="lesson-pagination__link" href="/lessons/@ReadingContext.Previous.Slug">
                <span>← Previous lesson</span>
                <strong>@ReadingContext.Previous.Title</strong>
            </a>
        }
        else
        {
            <span class="lesson-pagination__edge">This is the first complete lesson.</span>
        }

        @if (ReadingContext.Next is not null)
        {
            <a class="lesson-pagination__link lesson-pagination__link--next" href="/lessons/@ReadingContext.Next.Slug">
                <span>Next lesson →</span>
                <strong>@ReadingContext.Next.Title</strong>
            </a>
        }
        else
        {
            <span class="lesson-pagination__edge lesson-pagination__edge--next">You reached the last complete lesson.</span>
        }
    </nav>
}

@code {
    [Parameter]
    public string LessonSlug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "attempt")]
    public Guid? AttemptId { get; set; }

    [SupplyParameterFromQuery(Name = "answerRequired")]
    public bool AnswerRequired { get; set; }

    private CurriculumLessonReadingContext? ReadingContext { get; set; }

    private LearningSessionProgress SessionProgress { get; set; } = new();

    private QuizEvaluationResult? EvaluationResult { get; set; }

    private bool IsLessonComplete => ReadingContext is not null
        && SessionProgress.IsLessonComplete(ReadingContext.Current.Lesson.Id);

    private string FeedbackClass => EvaluationResult?.Status == QuizEvaluationStatus.Correct
        ? "quiz-feedback--correct"
        : EvaluationResult?.Status == QuizEvaluationStatus.Incorrect
            ? "quiz-feedback--incorrect"
            : "quiz-feedback--required";

    private string FeedbackHeading => EvaluationResult?.Status switch
    {
        QuizEvaluationStatus.Correct => "Correct answer",
        QuizEvaluationStatus.Incorrect => "Try again",
        _ => "Answer needed",
    };

    protected override void OnParametersSet()
    {
        ReadingContext = CurriculumLessonNavigator.Resolve(
            CurriculumCatalog.GetManifest(),
            LessonSlug);
        SessionProgress = ProgressStore.Load();

        EvaluationResult = ResolveEvaluationResult();
    }

    private QuizEvaluationResult? ResolveEvaluationResult()
    {
        if (ReadingContext is null)
        {
            return null;
        }

        if (AnswerRequired)
        {
            return new QuizEvaluationResult(
                QuizEvaluationStatus.AnswerRequired,
                "Enter or choose an answer before checking it.",
                Explanation: null);
        }

        var attempt = AttemptId is null
            ? null
            : SessionProgress.Attempts.SingleOrDefault(item =>
                item.Id.Value == AttemptId
                && item.ExerciseId == ReadingContext.Current.Exercise.Id);

        return attempt?.Outcome switch
        {
            AttemptOutcome.Correct => new QuizEvaluationResult(
                QuizEvaluationStatus.Correct,
                "Correct. Your answer matches the lesson specification.",
                ReadingContext.Current.QuizCriteria.Explanation),
            AttemptOutcome.Incorrect => new QuizEvaluationResult(
                QuizEvaluationStatus.Incorrect,
                "Not quite. Review the explanation and try again.",
                ReadingContext.Current.QuizCriteria.Explanation),
            _ => null,
        };
    }

    private static string FormatConcept(string concept) =>
        concept.Replace('-', ' ');
}
