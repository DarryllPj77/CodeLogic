@page "/"

<PageTitle>CodeLogic | C# Control-Flow Studio</PageTitle>

<HeadContent>
    <meta name="description" content="Analyze a safe C# subset and explore its deterministic flowchart and bounded execution trace." />
</HeadContent>

<section class="workspace-welcome" aria-labelledby="welcome-title">
    <div class="workspace-welcome__content">
        <p class="eyebrow">C# analysis workspace</p>
        <h1 id="welcome-title">Understand control flow at a glance.</h1>
        <p>
            Inspect supported C# source, review positioned Roslyn diagnostics, generate a source-mapped flowchart,
            and step through CodeLogic's bounded teaching model without compiling or executing arbitrary code.
        </p>
        <div class="button-row">
            <a class="button button--primary" href="/playground">Open analysis workspace <span aria-hidden="true">→</span></a>
            <a class="button button--secondary" href="/playground#flowchart-title">View flowchart tools</a>
        </div>
    </div>

    <div class="workspace-welcome__preview" aria-label="Workspace capability summary">
        <div class="welcome-window-bar"><span></span><span></span><span></span><strong>Program.cs</strong></div>
        <div class="welcome-preview-grid">
            <div><small>Source</small><code>if (score &gt;= 5)</code></div>
            <div><small>Flow graph</small><span class="welcome-node welcome-node--start">Start</span><span class="welcome-connector">↓</span><span class="welcome-node welcome-node--decision">score ≥ 5?</span></div>
            <div><small>Properties</small><dl><dt>Type</dt><dd>Decision</dd><dt>Line</dt><dd>1:1</dd></dl></div>
        </div>
    </div>
</section>

<section class="workspace-capabilities" aria-label="CodeLogic capabilities">
    <article><span>01</span><h2>Analyze</h2><p>Clear syntax and supported-subset diagnostics with source locations.</p></article>
    <article><span>02</span><h2>Visualize</h2><p>Deterministic nodes, branch labels, loop paths, and equivalent text.</p></article>
    <article><span>03</span><h2>Trace safely</h2><p>Bounded simulation with visible variables and output—not general .NET execution.</p></article>
</section>
