@page "/progress"

<PageTitle>Progress | CodeLogic</PageTitle>

<HeadContent>
    <meta name="description" content="Preview how CodeLogic will present honest, understandable learning progress." />
</HeadContent>

<section class="page-header" aria-labelledby="progress-title">
    <p class="eyebrow">Progress</p>
    <h1 id="progress-title">Your learning journey</h1>
    <p>Progress tracking is not connected yet. It will be introduced as temporary in-session state before persistent accounts are added.</p>
</section>

<section class="empty-state" aria-labelledby="progress-empty-title">
    <div class="empty-state__mark" aria-hidden="true">0</div>
    <div>
        <p class="status-badge">No progress data</p>
        <h2 id="progress-empty-title">Complete a lesson when learning features arrive</h2>
        <p>This page will summarize completed lessons and practice attempts without claiming mastery from a single answer.</p>
        <a class="button button--secondary" href="/lessons">Preview planned lessons</a>
    </div>
</section>

<aside class="notice" aria-labelledby="privacy-title">
    <h2 id="privacy-title">Honest state</h2>
    <p>No learner information is collected or stored by this placeholder page.</p>
</aside>
