@page "/playground"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ICodeAnalysisService CodeAnalysisService
@inject IEditorStructureService EditorStructureService
@inject ICurriculumCatalog CurriculumCatalog
@inject IFlowchartTranslator FlowchartTranslator
@inject IMermaidFlowchartSerializer MermaidSerializer
@inject IPedagogicalInterpreter PedagogicalInterpreter
@inject ILogicalFeedbackService LogicalFeedbackService
@inject IJSRuntime JavaScript

<PageTitle>Playground | CodeLogic</PageTitle>

<HeadContent>
    <meta name="description" content="Edit supported C# snippets, review diagnostics, and preview a safe explanatory flowchart without compiling or executing them." />
</HeadContent>

<section class="page-header workspace-intro" aria-labelledby="playground-title">
    <p class="eyebrow">Analysis workspace</p>
    <h1 id="playground-title">C# control-flow studio</h1>
    <p>Edit supported source, inspect Roslyn diagnostics, generate a deterministic graph, and step through a bounded simulation. Nothing is compiled or run by .NET.</p>
</section>

<details class="notice notice--warning workspace-limitations">
    <summary id="editor-limitations-title">Safety model and current limitations</summary>
    <h2>Visible limitations</h2>
    <ul>
        <li>The editor uses Monaco for highlighting and code folding, without IntelliSense or compilation. If Monaco cannot load, a plain-text editor is used instead.</li>
        <li>Code is parsed and may be interpreted by CodeLogic's small teaching model. It is never compiled or executed as a .NET program.</li>
        <li>Flowcharts support sequence, nested <code>if/else</code>, <code>while</code>, <code>for</code>, and <code>do-while</code> within the stated nesting limit.</li>
        <li><code>break</code> and <code>continue</code> are not supported yet and produce an explanation.</li>
        <li>Traces support scalar values, expressions, output, branches, and the supported loops; arrays, methods, live input, and general .NET behavior are not simulated.</li>
        <li>A trace stops after @PedagogicalInterpreter.Limits.MaximumOperations operations.</li>
        <li>The editor accepts at most @EditorState.MaximumCharacters.ToString("N0") characters.</li>
        <li>Analysis stops after @CodeAnalysisService.Limits.MaximumDuration.TotalSeconds.ToString("N0") seconds and supports at most @CodeAnalysisService.Limits.MaximumNestingDepth nested control-flow statements.</li>
        <li>Save keeps one draft only in this browser's local storage. It is not synced to your account or another device.</li>
    </ul>
</details>

<div class="workspace-toolbar" id="workspace-settings">
    <div class="workspace-file-tab"><span aria-hidden="true">#</span> Program.cs <span class="unsaved-indicator" title="Browser-local draft">●</span></div>
    <div class="workspace-operation-status" role="status" aria-live="polite" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
        @if (IsBusy)
        {
            <span class="operation-spinner" aria-hidden="true"></span>
        }
        <span>@StatusMessage</span>
    </div>
    <div class="workspace-view-actions" aria-label="Workspace view">
        <button type="button" class="icon-button" title="Split editor and flowchart" aria-pressed="@(WorkspaceMode == "split" ? "true" : "false")" @onclick='() => SetWorkspaceModeAsync("split")'>Split</button>
        <button type="button" class="icon-button" title="Focus flowchart" aria-pressed="@(WorkspaceMode == "focus" ? "true" : "false")" @onclick='() => SetWorkspaceModeAsync("focus")'>Flowchart focus</button>
        <button type="button" class="icon-button properties-drawer-trigger" aria-expanded="@IsPropertiesOpen.ToString().ToLowerInvariant()" @onclick="TogglePropertiesAsync">Node properties</button>
    </div>
</div>

<div @ref="WorkspaceRoot" class="ide-workspace ide-workspace--@WorkspaceMode @(IsExplorerCollapsed ? "ide-workspace--explorer-collapsed" : null) @(IsPropertiesOpen ? "ide-workspace--properties-open" : null) @(MaximizedPanel is null ? null : $"ide-workspace--max-{MaximizedPanel}") @(IsEditorCollapsed ? "ide-workspace--editor-collapsed" : null) @(IsFlowchartCollapsed ? "ide-workspace--flowchart-collapsed" : null)">
    <nav class="workspace-rail" aria-label="Workspace panels">
        <button type="button" class="rail-button @(ActiveSidebarPanel == "explorer" ? "rail-button--active" : null)" title="File Explorer" aria-label="File Explorer" aria-pressed="@(ActiveSidebarPanel == "explorer" && !IsExplorerCollapsed ? "true" : "false")" @onclick='() => ActivateSidebarAsync("explorer")'>▱</button>
        <button type="button" class="rail-button @(ActiveSidebarPanel == "structure" ? "rail-button--active" : null)" title="Code Structure" aria-label="Code Structure" aria-pressed="@(ActiveSidebarPanel == "structure" && !IsExplorerCollapsed ? "true" : "false")" @onclick='() => ActivateSidebarAsync("structure")'>{ }</button>
        <button type="button" class="rail-button" title="Flowchart Navigator" aria-label="Flowchart Navigator" @onclick='() => ScrollToAsync("flowchart-title")'>◇</button>
        <button type="button" class="rail-button" title="Focus source editor" aria-label="Focus source editor" @onclick="FocusEditorAsync">⌕</button>
        <button type="button" class="rail-button" title="Open diagnostics" aria-label="Open diagnostics" @onclick="OpenDiagnosticsAsync">△</button>
    </nav>

    <aside class="workspace-sidebar-strip workspace-sidebar-strip--explorer @(!IsExplorerCollapsed ? "workspace-sidebar-strip--hidden" : null)" aria-label="Collapsed Explorer">
        <button type="button" class="sidebar-expand-button" title="Expand Explorer" aria-label="Expand Explorer" @onclick="ToggleExplorerAsync">›</button>
        <span aria-hidden="true">Explorer</span>
    </aside>

    <aside class="workspace-explorer" aria-labelledby="explorer-title">
        <div class="panel-title"><h2 id="explorer-title">@(ActiveSidebarPanel == "structure" ? "Code structure" : "Explorer")</h2><button type="button" class="panel-close" aria-label="Collapse Explorer" title="Collapse Explorer" @onclick="ToggleExplorerAsync">×</button></div>
        @if (ActiveSidebarPanel == "structure")
        {
            <p class="tree-heading">GENERATED STRUCTURE</p>
            @if (FlowchartDocument is null)
            {
                <p class="explorer-note">Preview a flowchart to inspect its source-backed structure.</p>
            }
            else
            {
                <ul class="file-tree">
                    @foreach (var item in FlowchartDocument.SourceMap)
                    {
                        <li>
                            <button type="button" class="tree-button" title="@item.NodeType: @item.Label" @onclick="() => SelectNodeAsync(item)">
                                <span class="file-tree__icon" aria-hidden="true">◇</span>
                                <span class="file-tree__label">@item.NodeType · @item.Label</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <p class="tree-heading">CODELOGIC WORKSPACE</p>
            <ul class="file-tree">
                <li class="file-tree__folder"><span class="file-tree__icon" aria-hidden="true">⌄</span><span class="file-tree__label">Source</span></li>
                <li class="file-tree__file file-tree__file--active"><span class="file-tree__icon" aria-hidden="true">#</span><span class="file-tree__label">Program.cs</span></li>
                <li class="file-tree__folder"><span class="file-tree__icon" aria-hidden="true">›</span><span class="file-tree__label">Flow graph</span></li>
                <li class="file-tree__folder"><span class="file-tree__icon" aria-hidden="true">›</span><span class="file-tree__label">Diagnostics</span></li>
            </ul>
            <p class="explorer-note">Source text is the single source of truth. Diagram nodes are generated, not manually edited.</p>
        }
        <div class="resize-handle resize-handle--vertical" data-resize-panel="explorer" role="separator" tabindex="0" aria-label="Resize Explorer" aria-orientation="vertical" aria-valuemin="120" aria-valuemax="300" aria-valuenow="160" title="Drag or use arrow keys to resize. Double-click to reset."></div>
        <button type="button" class="sidebar-collapse-button sidebar-collapse-button--explorer" aria-label="Collapse Explorer" title="Collapse Explorer" @onclick="ToggleExplorerAsync"><span aria-hidden="true">‹</span></button>
    </aside>

<div class="playground-layout">
    <section class="editor-panel workspace-panel @(IsEditorCollapsed ? "workspace-panel--collapsed" : null)" aria-labelledby="editor-title">
        <div class="resize-handle resize-handle--vertical" data-resize-panel="editor" role="separator" tabindex="0" aria-label="Resize editor and analysis panels" aria-orientation="vertical" aria-valuemin="288" aria-valuemax="720" aria-valuenow="410" title="Drag or use arrow keys to resize. Double-click to reset."></div>
        <div class="section-heading panel-heading-row">
            <div>
                <p class="eyebrow">Monaco C# editor</p>
                <h2 id="editor-title">Edit a supported learning example</h2>
                <p>Tab and Shift+Tab indent code. Press Esc, then Tab to move to the next control.</p>
            </div>
            <div class="panel-window-actions">
                <button type="button" class="icon-button" aria-expanded="@(!IsEditorCollapsed)" aria-label="@(IsEditorCollapsed ? "Expand editor" : "Collapse editor")" @onclick='() => TogglePanel("editor")'>@(IsEditorCollapsed ? "›" : "‹")</button>
                <button type="button" class="icon-button" aria-pressed="@(MaximizedPanel == "editor")" @onclick='() => TogglePanelMaximized("editor")'>FULL</button>
            </div>
        </div>

        <div class="snippet-picker">
            <label for="snippet-select">Curated snippet</label>
            <select id="snippet-select" @bind="SelectedSnippetId" disabled="@(!BrowserReady)">
                @foreach (var snippet in EditorState.Snippets)
                {
                    <option value="@snippet.Id">@snippet.Title</option>
                }
            </select>
            <button class="button button--secondary" type="button" @onclick="LoadSelectedSnippet" disabled="@(!BrowserReady)">
                Load snippet
            </button>
        </div>

        <p class="snippet-description">@EditorState.ActiveSnippet.Description</p>

        <label class="editor-label" id="code-editor-label">C# source text</label>
        <div id="code-editor"
             @ref="EditorElement"
             class="code-editor"
             role="region"
             aria-labelledby="code-editor-label"
             aria-describedby="editor-tab-help editor-help editor-character-count editor-status"
             aria-busy="@(BrowserReady ? "false" : "true")"></div>

        <div class="editor-meta">
            <p id="editor-tab-help">Tab indents. Press Esc, then Tab to leave the editor.</p>
            <p id="editor-help">
                Shortcuts: <kbd>Ctrl</kbd>+<kbd>S</kbd> saves; <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>R</kbd> resets.
            </p>
            <p id="editor-character-count">@EditorState.CurrentCode.Length / @EditorState.MaximumCharacters characters</p>
        </div>

        <div class="button-row" id="editor-actions">
            <button class="button button--primary" type="button" @onclick="AnalyzeAsync" disabled="@(!BrowserReady || IsAnalyzing)">
                @(IsAnalyzing ? "Checking…" : "Check syntax")
            </button>
            <button class="button button--primary" type="button" @onclick="PreviewFlowchartAsync" disabled="@(!BrowserReady || JavaScriptModule is null || IsRendering)">
                @(IsRendering ? "Rendering…" : "Preview flowchart")
            </button>
            <button class="button button--primary" type="button" @onclick="BuildTraceAsync" disabled="@(!BrowserReady || IsTracing)">
                @(IsTracing ? "Building trace…" : "Build step trace")
            </button>
            <button class="button button--secondary" type="button" @onclick="SaveDraftAsync" disabled="@(!BrowserReady || JavaScriptModule is null)">Save browser draft</button>
            <button class="button button--secondary" type="button" @onclick="ResetDraftAsync" disabled="@(!BrowserReady)">Reset editor</button>
        </div>

        <p id="editor-status" class="editor-status">@EditorState.CurrentCode.Length / @EditorState.MaximumCharacters characters · local browser draft</p>

        @if (AnalysisResult is not null)
        {
            <section class="analysis-feedback" aria-labelledby="analysis-title" aria-live="polite">
                <h3 id="analysis-title">@AnalysisHeading(AnalysisResult.Status)</h3>
                @if (AnalysisResult.IsValid)
                {
                    <p>Roslyn understood the syntax, and every construct is inside CodeLogic's current learning subset.</p>
                    <p class="analysis-caution">This is not proof that the code compiles or produces the intended result. CodeLogic did not perform type checking or run it.</p>
                }
                else
                {
                    <ol class="analysis-diagnostic-list">
                        @foreach (var diagnostic in AnalysisResult.Diagnostics)
                        {
                            <li>
                                <p class="analysis-diagnostic-heading">
                                    <strong>@diagnostic.Code</strong>
                                    @if (diagnostic.Line is not null && diagnostic.Column is not null)
                                    {
                                        <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                                    }
                                </p>
                                <p>@diagnostic.Message</p>
                                <p class="analysis-explanation">@diagnostic.Explanation</p>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </section>

    <aside class="workspace-sidebar-strip workspace-sidebar-strip--properties @(IsPropertiesOpen ? "workspace-sidebar-strip--hidden" : null)" aria-label="Collapsed Node Properties">
        <button type="button" class="sidebar-expand-button" title="Expand Node Properties" aria-label="Expand Node Properties" @onclick="TogglePropertiesAsync">‹</button>
        <span aria-hidden="true">Properties</span>
    </aside>

    <aside class="playground-guide properties-panel" aria-labelledby="playground-guide-title">
        <div class="resize-handle resize-handle--vertical resize-handle--leading" data-resize-panel="properties" role="separator" tabindex="0" aria-label="Resize node properties" aria-orientation="vertical" aria-valuemin="220" aria-valuemax="420" aria-valuenow="240" title="Drag or use arrow keys to resize. Double-click to reset."></div>
        <button type="button" class="sidebar-collapse-button sidebar-collapse-button--properties" aria-label="Collapse Node Properties" title="Collapse Node Properties" @onclick="TogglePropertiesAsync"><span aria-hidden="true">›</span></button>
        <div class="panel-title"><h2 id="playground-guide-title">Node properties</h2><button type="button" class="panel-close" aria-label="Collapse Node Properties" title="Collapse Node Properties" @onclick="TogglePropertiesAsync">×</button></div>
        @if (SelectedNode is null)
        {
            <div class="properties-empty">
                <span aria-hidden="true">◇</span>
                <p>Select a generated node to inspect its source-backed properties.</p>
            </div>
        }
        else
        {
            <dl class="property-list">
                <div><dt>Name</dt><dd>@SelectedNode.Label</dd></div>
                <div><dt>Node type</dt><dd><span class="node-kind node-kind--@SelectedNode.NodeType.ToString().ToLowerInvariant()">@SelectedNode.NodeType</span></dd></div>
                <div><dt>Source file</dt><dd><code>Program.cs</code></dd></div>
                @if (SelectedNode.NodeType == FlowNodeType.Decision)
                {
                    <div><dt>Control kind</dt><dd>@(SelectedNodeIsLoop ? "Loop condition" : "Decision")</dd></div>
                    <div><dt>True path</dt><dd>@(BranchTarget(FlowEdgeType.True) ?? "No true edge")</dd></div>
                    <div><dt>False path</dt><dd>@(BranchTarget(FlowEdgeType.False) ?? "No false edge")</dd></div>
                }
                @if (SelectedNode.SourceSpan is not null)
                {
                    <div><dt>Source line</dt><dd>@SelectedNode.SourceSpan.StartLine:@SelectedNode.SourceSpan.StartColumn</dd></div>
                    <div><dt>Source range</dt><dd>@SelectedNode.SourceSpan.Length characters</dd></div>
                }
            </dl>
            @if (SelectedNode.SourceSpan is not null)
            {
                <div class="node-source-editor">
                    <label for="node-source-text">Mapped C# statement</label>
                    <textarea id="node-source-text" @bind="NodeEditText" @bind:event="oninput" rows="4" maxlength="@EditorState.MaximumCharacters" spellcheck="false"></textarea>
                    <button class="button button--primary" type="button" @onclick="ApplyNodeEditAsync">Apply safe edit</button>
                    @if (NodeEditMessage is not null)
                    {
                        <p class="node-edit-message" role="status">@NodeEditMessage</p>
                    }
                </div>
                <button class="button button--secondary" type="button" @onclick="() => ShowSourceAsync(SelectedNode!)">Reveal in source</button>
            }
        }
    </aside>
</div>

<section class="logic-feedback-panel" aria-labelledby="logic-feedback-title" aria-live="polite">
    <div class="section-heading">
        <p class="eyebrow">Instructor-defined checks</p>
        <h2 id="logic-feedback-title">Logical mistake feedback</h2>
        <p>Try the known age exercise, then compare its output for values below, at, and above the adult boundary.</p>
    </div>

    <div class="known-exercise-card">
        <div>
            <h3>@LogicalExercise.Title</h3>
            <p>@LogicalExercise.Objective</p>
        </div>
        <div class="button-row">
            <button class="button button--secondary" type="button" @onclick="LoadLogicalExercise" disabled="@(!BrowserReady)">Load age exercise</button>
            <button class="button button--primary" type="button" @onclick="CheckLogicAsync" disabled="@(!BrowserReady || IsCheckingLogic)">
                @(IsCheckingLogic ? "Checking cases…" : "Check known cases")
            </button>
        </div>
    </div>

    @if (LogicalFeedbackResult is null)
    {
        <div class="flowchart-empty">
            <h3>No logical check yet</h3>
            <p>These checks are available only for this known exercise. They are separate from C# syntax diagnostics.</p>
        </div>
    }
    else if (!LogicalFeedbackResult.HasTestResults)
    {
        <div class="analysis-feedback" role="status">
            <h3>Fix syntax or supported-subset issues first</h3>
            <p>No logical verdict was produced. Review these analysis or exercise-setup items:</p>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in LogicalFeedbackResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else
    {
        <div class="logic-summary @(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed ? "logic-summary--passed" : "logic-summary--failed")" role="status">
            <h3>@(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed ? "All known cases passed" : "One or more known cases failed")</h3>
            <p>@(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed
                ? "The output matched every instructor-defined case below."
                : "Compare expected and actual output, then use the hint for the failing case.")</p>
        </div>

        <div class="logic-table-wrapper">
            <table class="logic-table">
                <thead>
                    <tr>
                        <th scope="col">Case</th>
                        <th scope="col">Input</th>
                        <th scope="col">Expected</th>
                        <th scope="col">Actual</th>
                        <th scope="col">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in LogicalFeedbackResult.Tests)
                    {
                        <tr>
                            <th scope="row">
                                @test.Name
                                @if (test.IsBoundary)
                                {
                                    <span class="boundary-badge">Boundary</span>
                                }
                            </th>
                            <td><code>age = @test.Input</code></td>
                            <td><code>@test.ExpectedOutput</code></td>
                            <td><code>@test.ActualOutput</code></td>
                            <td><strong>@(test.Passed ? "Pass" : "Fail")</strong></td>
                        </tr>
                        @if (test.Hint is not null)
                        {
                            <tr class="logic-hint-row">
                                <td colspan="5"><strong>Hint:</strong> @test.Hint</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="notice notice--warning logic-limitation">
            <h3>Important limitation</h3>
            <p>@LogicalFeedbackResult.CoverageLimitation</p>
            <p>For example, code written only for ages 18 and 19 can pass these checks while still classifying age 20 incorrectly.</p>
        </div>
    }
</section>

<section class="flowchart-panel workspace-panel @(IsFlowchartCollapsed ? "workspace-panel--collapsed" : null)" aria-labelledby="flowchart-title" aria-live="polite">
    <div class="canvas-header-sticky">
        <div class="panel-heading-row">
            <div>
                <p class="eyebrow">Deterministic visualization</p>
                <h2 id="flowchart-title">Flowchart canvas</h2>
            </div>
            <div class="canvas-header-actions">
                <div class="panel-window-actions">
                    <button type="button" class="icon-button" aria-expanded="@(!IsFlowchartCollapsed)" aria-label="@(IsFlowchartCollapsed ? "Expand flowchart" : "Collapse flowchart")" @onclick='() => TogglePanel("flowchart")'>@(IsFlowchartCollapsed ? "‹" : "›")</button>
                    <button type="button" class="icon-button" aria-pressed="@(MaximizedPanel == "flowchart")" @onclick='() => TogglePanelMaximized("flowchart")'>FULL</button>
                </div>
                @if (TraceNavigator is not null)
                {
                    <div class="canvas-trace-controls" aria-label="Canvas trace controls">
                        <button class="icon-button canvas-play-button" type="button" @onclick="ToggleTracePlaybackAsync" disabled="@(IsPredictionMode || (!TraceNavigator.CanStep && !IsTracePlaying))">@(IsTracePlaying ? "Pause" : "Play")</button>
                        <button class="icon-button" type="button" @onclick="NextTraceStepAsync" disabled="@(!TraceNavigator.CanStep || IsTracePlaying || (IsPredictionMode && CurrentPrediction is not null))">Step</button>
                        <button class="icon-button" type="button" @onclick="PreviousTraceStepAsync" disabled="@(!TraceNavigator.CanStepBack || IsTracePlaying)">Back</button>
                        <button class="icon-button" type="button" @onclick="ResetTraceAsync">Reset</button>
                        <label class="canvas-trace-speed" for="canvas-trace-speed">
                            Speed
                            <input id="canvas-trace-speed" type="range" min="200" max="1600" step="100" @bind="TracePlaybackDelayMilliseconds" @bind:event="oninput" aria-valuetext="@TraceSpeedDescription" />
                        </label>
                        <label class="canvas-prediction-toggle">
                            <input type="checkbox" checked="@IsPredictionMode" @onchange="TogglePredictionModeAsync" />
                            Predict
                        </label>
                    </div>
                }
                <div class="canvas-controls" aria-label="Flowchart zoom controls">
                    <button type="button" class="icon-button" @onclick="() => AdjustFlowchartZoomAsync(-0.1)" aria-label="Zoom out">−</button>
                    <output aria-label="Current zoom">@($"{FlowchartZoom:P0}")</output>
                    <button type="button" class="icon-button" @onclick="() => AdjustFlowchartZoomAsync(0.1)" aria-label="Zoom in">+</button>
                    <button type="button" class="icon-button" @onclick="FitFlowchartAsync">Fit</button>
                </div>
                <details class="flowchart-legend">
                    <summary>Legend</summary>
                    <ul>
                        <li><span class="legend-swatch legend-swatch--selected"></span>Selected</li>
                        <li><span class="legend-swatch legend-swatch--decision"></span>Decision</li>
                        <li><span class="legend-swatch legend-swatch--error"></span>Diagnostic</li>
                        <li><span class="legend-line legend-line--loop"></span>Loop</li>
                        <li><span class="legend-line legend-line--exit"></span>Exit</li>
                    </ul>
                </details>
            </div>
        </div>
        <p class="canvas-step-summary" role="status">@TraceCanvasDescription · Explored @ExploredNodeIds.Count/@(FlowchartDocument?.SourceMap.Count ?? 0) nodes</p>
        @if (IsPredictionMode && CurrentPrediction is not null)
        {
            <form class="canvas-prediction" @onsubmit="SubmitPredictionAsync" @onsubmit:preventDefault>
                <AntiforgeryToken />
                <label for="canvas-trace-prediction-answer">@CurrentPrediction.Prompt</label>
                <input id="canvas-trace-prediction-answer" type="text" @bind="PredictionAnswer" @bind:event="oninput" autocomplete="off" />
                <button class="icon-button canvas-play-button" type="submit">Check and step</button>
            </form>
        }
        @if (PredictionFeedback is not null && IsPredictionMode)
        {
            <p class="canvas-prediction-feedback" role="status">@PredictionFeedback</p>
        }
    </div>

    @if (FlowchartResult is null)
    {
        <div class="flowchart-empty">
            <h3>No preview yet</h3>
            <p>Choose <strong>Preview flowchart</strong> to visualize supported sequence, branching, or loop source.</p>
        </div>
    }
    else if (!FlowchartResult.IsSuccess)
    {
        <div class="analysis-feedback" role="status">
            <h3>@FlowchartHeading(FlowchartResult.Status)</h3>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in FlowchartResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else if (FlowchartDocument is not null)
    {
        @if (LiveFlowchartFailure is not null)
        {
            <div class="analysis-feedback live-flowchart-diagnostics" role="status">
                <h3>Keeping the last valid flowchart</h3>
                <p>The latest editor text could not produce a supported graph. Fix these items or use Preview flowchart to retry:</p>
                <ol class="analysis-diagnostic-list">
                    @foreach (var diagnostic in LiveFlowchartFailure.Diagnostics)
                    {
                        <li><strong>@diagnostic.Code</strong> @diagnostic.Message</li>
                    }
                </ol>
            </div>
        }

        @if (RendererError is not null)
        {
            <div class="notice notice--warning" role="alert">
                <h3>Diagram renderer unavailable</h3>
                <p>@RendererError</p>
                <p>The source and deterministic text map remain available below.</p>
            </div>
        }

        <div class="flowchart-canvas"
             @ref="FlowchartContainer"
             aria-label="Rendered CodeLogic flowchart"
             aria-busy="@IsRendering.ToString().ToLowerInvariant()"></div>

        <div class="flowchart-text-map">
            <h3>Equivalent text and source map</h3>
            <p>Select a source-backed node to return to the exact text that produced it.</p>
            <ol class="flowchart-node-list">
                @foreach (var item in FlowchartDocument.SourceMap)
                {
                    <li class="@(SelectedNode?.NodeId == item.NodeId ? "source-map-item--selected" : null)">
                        <strong>@item.NodeType:</strong> @item.Label
                        <button class="text-button" type="button" @onclick="() => SelectNodeAsync(item)">
                            @(item.SourceSpan is null ? "Inspect node" : $"Show line {item.SourceSpan.StartLine}")
                        </button>
                    </li>
                }
            </ol>

            <h3>Connections</h3>
            <ul class="flowchart-edge-list">
                @foreach (var edge in FlowchartResult.Graph!.Edges)
                {
                    <li>@DescribeEdge(edge, FlowchartResult.Graph)</li>
                }
            </ul>
        </div>
    }
</section>

<section class="trace-panel bottom-panel bottom-panel--@ActiveBottomTab @(IsBottomPanelCollapsed ? "bottom-panel--collapsed" : null)" id="analysis-output" aria-labelledby="trace-title" aria-live="polite">
    <div class="resize-handle resize-handle--horizontal" data-resize-panel="bottom" role="separator" tabindex="0" aria-label="Resize output panel" aria-orientation="horizontal" aria-valuemin="160" aria-valuemax="520" aria-valuenow="280" title="Drag or use arrow keys to resize. Double-click to reset."></div>
    <div class="bottom-tabs" role="tablist" aria-label="Output panels">
        <button type="button" class="bottom-tab @(ActiveBottomTab == "diagnostics" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "diagnostics")" @onclick='() => ActiveBottomTab = "diagnostics"'>Diagnostics <span>@(AnalysisResult?.Diagnostics.Count ?? 0)</span></button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "analysis" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "analysis")" @onclick='() => ActiveBottomTab = "analysis"'>Analysis output</button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "trace" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "trace")" @onclick='() => ActiveBottomTab = "trace"'>Execution trace</button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "terminal" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "terminal")" @onclick='() => ActiveBottomTab = "terminal"'>Terminal</button>
        <button type="button" class="bottom-panel-toggle" aria-expanded="@(!IsBottomPanelCollapsed)" aria-label="@(IsBottomPanelCollapsed ? "Expand bottom panel" : "Collapse bottom panel")" @onclick="() => IsBottomPanelCollapsed = !IsBottomPanelCollapsed">@(IsBottomPanelCollapsed ? "⌃" : "⌄")</button>
        <button type="button" class="bottom-panel-toggle" aria-pressed="@(MaximizedPanel == "bottom")" @onclick='() => TogglePanelMaximized("bottom")'>FULL</button>
    </div>

    @if (ActiveBottomTab == "diagnostics")
    {
        <div class="bottom-tab-summary" role="tabpanel">
            <h2>Diagnostics</h2>
            <p>@(AnalysisResult is null ? "Run Analyze code to populate syntax and supported-subset diagnostics." : $"Analysis reported {AnalysisResult.Diagnostics.Count} diagnostic item(s). Full positioned explanations remain beside the editor.")</p>
        </div>
    }
    else if (ActiveBottomTab == "analysis")
    {
        <div class="bottom-tab-summary" role="tabpanel">
            <h2>Analysis output</h2>
            <p>@StatusMessage</p>
        </div>
    }
    else if (ActiveBottomTab == "terminal")
    {
        <div class="bottom-tab-summary terminal-safe-state" role="tabpanel">
            <h2>Terminal unavailable</h2>
            <p>CodeLogic does not expose a shell or run arbitrary .NET code. Use the bounded Execution trace for supported teaching examples.</p>
        </div>
    }

    <div class="trace-tab-content">
    <div class="section-heading">
        <p class="eyebrow">Bounded teaching model</p>
        <h2 id="trace-title">Step trace</h2>
        <p>This is CodeLogic's deterministic simulation of a small C#-shaped subset. It is not the .NET runtime and does not claim general C# behavior.</p>
    </div>

    @if (TraceResult is null)
    {
        <div class="flowchart-empty">
            <h3>No trace yet</h3>
            <p>Choose <strong>Build step trace</strong> to inspect the program counter, active graph node, variables, and simulated output.</p>
        </div>
    }
    else if (!TraceResult.HasTrace)
    {
        <div class="analysis-feedback" role="status">
            <h3>@TraceHeading(TraceResult.Status)</h3>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in TraceResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else if (TraceNavigator is not null)
    {
        @if (TraceResult.Status == ExecutionTraceStatus.StepLimitReached)
        {
            <div class="notice notice--warning" role="status">
                <h3>Operation limit reached</h3>
                <p>@TraceResult.Diagnostics[0].Message @TraceResult.Diagnostics[0].Explanation</p>
            </div>
        }

        <div class="trace-controls">
            <p><strong>Trace step @TraceNavigator.StepNumber of @TraceNavigator.StepCount</strong></p>
            <div class="trace-playback-row">
                <div class="button-row" aria-label="Trace playback controls">
                    <button class="button button--primary" type="button" @onclick="ToggleTracePlaybackAsync" disabled="@(IsPredictionMode || (!TraceNavigator.CanStep && !IsTracePlaying))">@(IsTracePlaying ? "Pause" : "Play")</button>
                    <button class="button button--secondary" type="button" @onclick="NextTraceStepAsync" disabled="@(!TraceNavigator.CanStep || IsTracePlaying || (IsPredictionMode && CurrentPrediction is not null))">Step</button>
                    <button class="button button--secondary" type="button" @onclick="PreviousTraceStepAsync" disabled="@(!TraceNavigator.CanStepBack || IsTracePlaying)">Back</button>
                    <button class="button button--secondary" type="button" @onclick="ResetTraceAsync">Reset</button>
                </div>
                <label class="trace-speed" for="trace-speed">
                    Speed
                    <input id="trace-speed" type="range" min="200" max="1600" step="100" @bind="TracePlaybackDelayMilliseconds" @bind:event="oninput" aria-valuetext="@TraceSpeedDescription" />
                    <span>@TraceSpeedDescription</span>
                </label>
            </div>
            <label class="prediction-toggle">
                <input type="checkbox" checked="@IsPredictionMode" @onchange="TogglePredictionModeAsync" />
                Predict before each meaningful step
            </label>
            @if (IsPredictionMode && CurrentPrediction is not null)
            {
                <form class="trace-prediction" @onsubmit="SubmitPredictionAsync" @onsubmit:preventDefault>
                    <AntiforgeryToken />
                    <label for="trace-prediction-answer">@CurrentPrediction.Prompt</label>
                    <div class="trace-prediction-row">
                        <input id="trace-prediction-answer" type="text" @bind="PredictionAnswer" @bind:event="oninput" autocomplete="off" />
                        <button class="button button--primary" type="submit">Check and step</button>
                    </div>
                </form>
            }
            @if (PredictionFeedback is not null)
            {
                <p class="prediction-feedback prediction-feedback--@(PredictionWasCorrect == true ? "correct" : "incorrect")" role="status">@PredictionFeedback</p>
            }
        </div>

        <div class="trace-state">
            <section aria-labelledby="trace-operation-title">
                <h3 id="trace-operation-title">Active operation</h3>
                <dl class="trace-details">
                    <div><dt>Program counter</dt><dd>@TraceNavigator.Current.ProgramCounter</dd></div>
                    <div><dt>Graph node</dt><dd><code>@TraceNavigator.Current.ActiveNodeId</code> · @TraceNavigator.Current.ActiveNodeType</dd></div>
                    <div><dt>Source meaning</dt><dd>@TraceNavigator.Current.ActiveNodeLabel</dd></div>
                    @if (CurrentTraceNodeIsLoop)
                    {
                        <div><dt>Loop iteration</dt><dd>@Math.Max(0, TraceNavigator.CurrentNodeVisitCount - 1)</dd></div>
                    }
                </dl>
                <p>@TraceNavigator.Current.Explanation</p>
            </section>

            <section aria-labelledby="trace-variables-title">
                <h3 id="trace-variables-title">Variables</h3>
                @if (TraceNavigator.Current.Variables.Count == 0)
                {
                    <p>No variables have values yet.</p>
                }
                else
                {
                    <table class="trace-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
                        <tbody>
                            @foreach (var variable in TraceNavigator.Current.Variables)
                            {
                                <tr class="@(TraceNavigator.ChangedVariables.Contains(variable.Key) ? "trace-variable--changed" : null)">
                                    <th scope="row"><code>@variable.Key</code></th>
                                    <td><code>@variable.Value</code>@if (TraceNavigator.ChangedVariables.Contains(variable.Key)) { <span class="visually-hidden"> changed this step</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section aria-labelledby="trace-output-title">
                <h3 id="trace-output-title">Console output</h3>
                @if (TraceNavigator.Current.Output.Count == 0)
                {
                    <p>No <code>Console.WriteLine</code> output has been produced at this step.</p>
                }
                else
                {
                    <pre class="trace-output" aria-live="polite">@string.Join(Environment.NewLine, TraceNavigator.Current.Output)</pre>
                }
            </section>
        </div>
    }
    </div>
</section>

@if (ToastMessage is not null)
{
    <div class="workspace-toast workspace-toast--@ToastKind" role="@(ToastKind == "error" ? "alert" : "status")">
        <span aria-hidden="true">@(ToastKind == "error" ? "!" : "✓")</span>
        <p>@ToastMessage</p>
        <button type="button" aria-label="Dismiss notification" @onclick="DismissToast">×</button>
    </div>
}
</div>

@code {
    private const string DraftStorageKey = "CodeLogic.Playground.Draft.v1";
    private const string WorkspaceStorageKey = "CodeLogic.Playground.Workspace.v1";
    private static LogicalExerciseSpecification LogicalExercise => KnownLogicalExercises.AgeBoundary;
    private PlaygroundEditorState EditorState { get; set; } = null!;
    private string SelectedSnippetId { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = "Preparing browser draft storage.";
    private bool BrowserReady { get; set; }
    private bool IsAnalyzing { get; set; }
    private bool IsRendering { get; set; }
    private bool IsTracing { get; set; }
    private bool IsCheckingLogic { get; set; }
    private bool RenderPending { get; set; }
    private CodeAnalysisResult? AnalysisResult { get; set; }
    private FlowchartTranslationResult? FlowchartResult { get; set; }
    private FlowchartTranslationResult? LiveFlowchartFailure { get; set; }
    private MermaidFlowchartDocument? FlowchartDocument { get; set; }
    private string? RendererError { get; set; }
    private ExecutionTraceResult? TraceResult { get; set; }
    private ExecutionTraceNavigator? TraceNavigator { get; set; }
    private LogicalFeedbackResult? LogicalFeedbackResult { get; set; }
    private int RenderSequence { get; set; }
    private double FlowchartZoom { get; set; } = 1;
    private string WorkspaceMode { get; set; } = "split";
    private string ActiveSidebarPanel { get; set; } = "explorer";
    private string ActiveBottomTab { get; set; } = "trace";
    private bool IsBottomPanelCollapsed { get; set; }
    private bool IsExplorerCollapsed { get; set; }
    private bool IsPropertiesOpen { get; set; } = true;
    private bool IsEditorCollapsed { get; set; }
    private bool IsFlowchartCollapsed { get; set; }
    private string? MaximizedPanel { get; set; }
    private bool IsTracePlaying { get; set; }
    private bool IsPredictionMode { get; set; }
    private int TracePlaybackDelayMilliseconds { get; set; } = 700;
    private TracePrediction? CurrentPrediction { get; set; }
    private string PredictionAnswer { get; set; } = string.Empty;
    private string? PredictionFeedback { get; set; }
    private bool? PredictionWasCorrect { get; set; }
    private string? ToastMessage { get; set; }
    private string NodeEditText { get; set; } = string.Empty;
    private string? NodeEditMessage { get; set; }
    private string ToastKind { get; set; } = "success";
    private int ToastVersion { get; set; }
    private bool IsDisposed { get; set; }
    private FlowNodeSourceMap? SelectedNode { get; set; }
    private HashSet<string> ExploredNodeIds { get; } = new(StringComparer.Ordinal);
    private IReadOnlyList<EditorFoldRegion> EditorFoldRegions { get; set; } = [];
    private ElementReference WorkspaceRoot { get; set; }
    private ElementReference EditorElement { get; set; }
    private ElementReference FlowchartContainer { get; set; }
    private IJSObjectReference? JavaScriptModule { get; set; }
    private IJSObjectReference? WorkspaceModule { get; set; }
    private DotNetObjectReference<Playground>? ComponentReference { get; set; }
    private CancellationTokenSource? TracePlaybackCancellation { get; set; }
    private PlaygroundFlowchartDebouncer FlowchartDebouncer { get; } = new(TimeSpan.FromMilliseconds(400));
    private PlaygroundFlowchartDebouncer StructureDebouncer { get; } = new(TimeSpan.FromMilliseconds(150));
    private bool IsBusy => IsAnalyzing || IsRendering || IsTracing || IsCheckingLogic;
    private bool SelectedNodeIsLoop => SelectedNode is not null
        && FlowchartResult?.Graph?.Edges.Any(edge => edge.Type == FlowEdgeType.LoopBack && edge.ToNodeId == SelectedNode.NodeId) == true;
    private bool CurrentTraceNodeIsLoop => TraceNavigator is not null
        && FlowchartResult?.Graph?.Edges.Any(edge => edge.Type == FlowEdgeType.LoopBack
            && edge.ToNodeId == TraceNavigator.Current.ActiveNodeId) == true;
    private string TraceSpeedDescription => TracePlaybackDelayMilliseconds switch
    {
        <= 300 => "Fast",
        <= 800 => "Normal",
        _ => "Slow",
    };
    private string TraceCanvasDescription => TraceNavigator is null
        ? "Build a step trace to control the bounded simulation beside the flowchart."
        : $"Step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}: {TraceNavigator.Current.Explanation}";

    protected override void OnInitialized()
    {
        var manifest = CurriculumCatalog.GetManifest();
        var snippets = manifest.Lessons
            .Where(lesson => lesson.Status == CurriculumLessonStatus.Complete)
            .Select(lesson => new PlaygroundSnippet(
                lesson.Lesson.Id.ToString(),
                lesson.Lesson.Title,
                lesson.Lesson.Objective,
                lesson.SampleCode));

        EditorState = new PlaygroundEditorState(
            snippets,
            manifest.SafeSnippetPolicy.MaximumCharacters);
        SelectedSnippetId = EditorState.ActiveSnippet.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                JavaScriptModule = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/playground.js?v=3");
                WorkspaceModule = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/workspace.js?v=2");
                ComponentReference = DotNetObjectReference.Create(this);
                var layoutRestored = await WorkspaceModule.InvokeAsync<bool>(
                    "initializeWorkspace",
                    WorkspaceRoot,
                    WorkspaceStorageKey);
                var savedDraft = await JavaScriptModule.InvokeAsync<string?>(
                    "loadDraft",
                    DraftStorageKey);

                if (savedDraft is not null)
                {
                    if (EditorState.TryUpdateCode(savedDraft))
                    {
                        EditorState.MarkSaved();
                        StatusMessage = "Saved browser draft restored.";
                    }
                    else
                    {
                        await JavaScriptModule.InvokeVoidAsync("clearDraft", DraftStorageKey);
                        StatusMessage = "An oversized saved draft was discarded. The curated snippet remains loaded.";
                    }
                }
                else
                {
                    StatusMessage = layoutRestored
                        ? "Workspace layout restored. The current snippet has not been saved in this browser."
                        : "The current snippet has not been saved in this browser.";
                }

                EditorFoldRegions = await EditorStructureService.GetFoldRegionsAsync(EditorState.CurrentCode);
                var editorKind = await JavaScriptModule.InvokeAsync<string>(
                    "initializeCodeEditor",
                    EditorElement,
                    EditorState.CurrentCode,
                    EditorState.MaximumCharacters,
                    ComponentReference,
                    EditorFoldRegions);
                if (editorKind == "plain")
                {
                    StatusMessage = "The Monaco editor could not load, so a plain-text editor is in use. Editing, Tab indentation, analysis, and saving still work; code folding is unavailable.";
                }
            }
            catch (JSException)
            {
                StatusMessage = "Browser features are unavailable. Editing and reset still work, but save and diagram rendering are disabled.";
            }
            finally
            {
                BrowserReady = true;
                StateHasChanged();
            }
        }

        if (RenderPending && JavaScriptModule is not null && FlowchartDocument is not null)
        {
            RenderPending = false;
            try
            {
                await JavaScriptModule.InvokeVoidAsync(
                    "renderMermaid",
                    FlowchartContainer,
                    FlowchartDocument.Definition,
                    $"codelogic-flowchart-{++RenderSequence}",
                    FlowchartDocument.SourceMap,
                    ComponentReference);
                await MarkFlowchartDiagnosticsAsync();
                StatusMessage = "Flowchart preview rendered. Nothing was compiled or executed.";
                ShowToast("Flowchart preview is ready.");
            }
            catch (JSException)
            {
                RendererError = "Mermaid could not render this preview. Check the browser connection and try again.";
                StatusMessage = "The visual renderer failed; the equivalent text map is still available.";
                ShowToast("Flowchart renderer failed. The text map is still available.", "error");
            }
            finally
            {
                IsRendering = false;
                StateHasChanged();
            }
        }
    }

    private void UpdateCode(string code)
    {
        AnalysisResult = null;
        ClearTraceAndFeedback();
        if (EditorState.TryUpdateCode(code))
        {
            StatusMessage = "Unsaved changes. Flowchart update scheduled.";
            _ = FlowchartDebouncer.ScheduleAsync(code, UpdateLiveFlowchartAsync);
            _ = StructureDebouncer.ScheduleAsync(code, UpdateEditorStructureAsync);
        }
        else
        {
            StatusMessage = $"The editor limit is {EditorState.MaximumCharacters:N0} characters.";
        }
    }

    [JSInvokable]
    public Task UpdateCodeFromBrowser(string code)
    {
        UpdateCode(code);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SaveEditorDraftFromBrowser() => SaveDraftAsync();

    [JSInvokable]
    public Task ResetEditorDraftFromBrowser() => ResetDraftAsync();

    private async Task LoadSelectedSnippet()
    {
        AnalysisResult = null;
        ClearFlowchart();
        EditorState.LoadSnippet(SelectedSnippetId);
        StatusMessage = $"Loaded {EditorState.ActiveSnippet.Title}. Save to keep it as your browser draft.";
        await SynchronizeEditorValueAsync();
        _ = FlowchartDebouncer.ScheduleAsync(EditorState.CurrentCode, UpdateLiveFlowchartAsync);
    }

    private async Task SaveDraftAsync()
    {
        if (JavaScriptModule is null)
        {
            StatusMessage = "Browser storage is unavailable, so this draft was not saved.";
            return;
        }

        try
        {
            await JavaScriptModule.InvokeVoidAsync(
                "saveDraft",
                DraftStorageKey,
                EditorState.CurrentCode,
                EditorState.MaximumCharacters);
            EditorState.MarkSaved();
            StatusMessage = "Draft saved in this browser.";
            ShowToast("Draft saved in this browser.");
        }
        catch (JSException)
        {
            StatusMessage = "The browser refused local storage, so this draft was not saved.";
            ShowToast("Draft could not be saved.", "error");
        }
    }

    private async Task ResetDraftAsync()
    {
        if (JavaScriptModule is not null
            && !await JavaScriptModule.InvokeAsync<bool>("confirmReset"))
        {
            StatusMessage = "Reset cancelled; the current source and browser draft were kept.";
            return;
        }

        AnalysisResult = null;
        ClearFlowchart();
        EditorState.Reset();
        await SynchronizeEditorValueAsync();
        if (JavaScriptModule is not null)
        {
            try
            {
                await JavaScriptModule.InvokeVoidAsync("clearDraft", DraftStorageKey);
            }
            catch (JSException)
            {
                StatusMessage = "The editor reset, but the browser's saved draft could not be cleared.";
                return;
            }
        }

        StatusMessage = $"Editor reset to {EditorState.ActiveSnippet.Title}; the browser draft was cleared.";
    }

    private async Task AnalyzeAsync()
    {
        IsAnalyzing = true;
        StatusMessage = "Checking syntax and the supported learning subset.";
        try
        {
            AnalysisResult = await CodeAnalysisService.AnalyzeAsync(EditorState.CurrentCode);
            StatusMessage = AnalysisResult.IsValid
                ? "Syntax and supported-subset check passed. Nothing was compiled or run."
                : $"Analysis found {AnalysisResult.Diagnostics.Count} item(s) to review.";
            ShowToast(
                AnalysisResult.IsValid ? "Syntax check passed." : $"Review {AnalysisResult.Diagnostics.Count} analysis item(s).",
                AnalysisResult.IsValid ? "success" : "warning");
            await MarkFlowchartDiagnosticsAsync();
        }
        finally
        {
            IsAnalyzing = false;
        }
    }

    private async Task PreviewFlowchartAsync()
    {
        FlowchartDebouncer.Cancel();
        IsRendering = true;
        RendererError = null;
        StatusMessage = "Building a deterministic flowchart from supported syntax.";

        var result = await FlowchartTranslator.TranslateAsync(EditorState.CurrentCode);
        if (!result.IsSuccess)
        {
            LiveFlowchartFailure = result;
            IsRendering = false;
            StatusMessage = $"Flowchart translation found {result.Diagnostics.Count} item(s). The last valid chart was kept.";
            return;
        }

        ApplyValidFlowchart(result, "The graph is ready; rendering the browser preview.");
    }

    private async Task UpdateLiveFlowchartAsync(string source, CancellationToken cancellationToken)
    {
        try
        {
            var result = await FlowchartTranslator.TranslateAsync(source, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            await InvokeAsync(() =>
            {
                if (result.IsSuccess)
                {
                    ApplyValidFlowchart(result, "Flowchart updated from the editor. Nothing was compiled or executed.");
                }
                else
                {
                    LiveFlowchartFailure = result;
                    IsRendering = false;
                    StatusMessage = $"Live flowchart update found {result.Diagnostics.Count} item(s); the last valid chart remains visible.";
                }

                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer editor change superseded this translation.
        }
        catch (Exception)
        {
            await InvokeAsync(() =>
            {
                IsRendering = false;
                StatusMessage = "Live flowchart update failed safely; the last valid chart remains visible.";
                ShowToast("Live flowchart update failed safely.", "error");
                StateHasChanged();
            });
        }
    }

    private void ApplyValidFlowchart(FlowchartTranslationResult result, string statusMessage)
    {
        FlowchartResult = result;
        FlowchartDocument = MermaidSerializer.Serialize(result.Graph!);
        LiveFlowchartFailure = null;
        SelectedNode = FlowchartDocument.SourceMap.FirstOrDefault();
        ExploredNodeIds.Clear();
        if (SelectedNode is not null)
        {
            ExploredNodeIds.Add(SelectedNode.NodeId);
        }
        FlowchartZoom = 1;
        IsRendering = true;
        RenderPending = true;
        StatusMessage = statusMessage;
    }

    private async Task BuildTraceAsync()
    {
        IsTracing = true;
        TraceNavigator = null;
        StatusMessage = "Building a bounded teaching trace. No .NET program is being run.";
        try
        {
            TraceResult = await PedagogicalInterpreter.TraceAsync(EditorState.CurrentCode);
            if (TraceResult.HasTrace)
            {
                TraceNavigator = new ExecutionTraceNavigator(TraceResult);
                PreparePrediction(clearFeedback: true);
                StatusMessage = TraceResult.Status == ExecutionTraceStatus.StepLimitReached
                    ? $"Trace stopped safely at the {TraceResult.MaximumOperations}-operation limit."
                    : $"Trace built with {TraceResult.Steps.Count} snapshots. Use Next step to inspect it.";
                ShowToast("Bounded execution trace is ready.");
                await SynchronizeTraceStepAsync();
            }
            else
            {
                StatusMessage = $"Trace simulation found {TraceResult.Diagnostics.Count} item(s) to review.";
            }
        }
        finally
        {
            IsTracing = false;
        }
    }

    private async Task LoadLogicalExercise()
    {
        AnalysisResult = null;
        ClearFlowchart();
        if (!EditorState.TryUpdateCode(LogicalExercise.StarterCode))
        {
            StatusMessage = "The known exercise exceeds the editor limit and could not be loaded.";
            return;
        }

        await SynchronizeEditorValueAsync();
        StatusMessage = "Loaded the Adult age boundary exercise. Change its comparison, then check the known cases.";
    }

    private async Task CheckLogicAsync()
    {
        IsCheckingLogic = true;
        StatusMessage = "Checking three instructor-defined age cases with the bounded interpreter.";
        try
        {
            LogicalFeedbackResult = await LogicalFeedbackService.EvaluateAsync(
                LogicalExercise,
                EditorState.CurrentCode);
            StatusMessage = LogicalFeedbackResult.Status switch
            {
                LogicalFeedbackStatus.Passed => "All three known age cases passed; untested ages may still reveal a mistake.",
                LogicalFeedbackStatus.Failed => "A known age case failed. Compare expected and actual output below.",
                _ => "Logic was not checked because syntax, support, or exercise setup needs attention first.",
            };
        }
        finally
        {
            IsCheckingLogic = false;
        }
    }

    private async Task NextTraceStepAsync()
    {
        if (IsPredictionMode && CurrentPrediction is not null)
        {
            PredictionFeedback = "Make a prediction below before advancing this step.";
            PredictionWasCorrect = false;
            return;
        }

        TraceNavigator?.Step();
        if (TraceNavigator is not null)
        {
            PreparePrediction(clearFeedback: true);
            StatusMessage = $"Trace step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}: {TraceNavigator.Current.ActiveNodeLabel}.";
            await SynchronizeTraceStepAsync();
        }
    }

    private async Task PreviousTraceStepAsync()
    {
        TraceNavigator?.StepBack();
        if (TraceNavigator is not null)
        {
            PreparePrediction(clearFeedback: true);
            StatusMessage = $"Returned to trace step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}.";
            await SynchronizeTraceStepAsync();
        }
    }

    private async Task ResetTraceAsync()
    {
        StopTracePlayback();
        TraceNavigator?.Reset();
        PreparePrediction(clearFeedback: true);
        StatusMessage = "Trace reset to its initial state.";
        await SynchronizeTraceStepAsync();
    }

    private Task TogglePredictionModeAsync(ChangeEventArgs eventArgs)
    {
        IsPredictionMode = eventArgs.Value is true
            || string.Equals(eventArgs.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (IsPredictionMode)
        {
            StopTracePlayback();
        }

        PreparePrediction(clearFeedback: true);
        StatusMessage = IsPredictionMode
            ? "Prediction practice enabled. Automatic playback is paused while you answer each prompt."
            : "Prediction practice disabled.";
        return Task.CompletedTask;
    }

    private async Task SubmitPredictionAsync()
    {
        if (TraceNavigator is null || CurrentPrediction is null)
        {
            return;
        }

        var result = TracePredictionEvaluator.Evaluate(CurrentPrediction, PredictionAnswer);
        PredictionFeedback = result.Feedback;
        PredictionWasCorrect = result.IsCorrect;
        if (string.IsNullOrWhiteSpace(PredictionAnswer))
        {
            return;
        }

        TraceNavigator.Step();
        PredictionAnswer = string.Empty;
        CurrentPrediction = CreatePrediction();
        StatusMessage = $"Prediction checked. Trace advanced to step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}.";
        await SynchronizeTraceStepAsync();
    }

    private void PreparePrediction(bool clearFeedback)
    {
        PredictionAnswer = string.Empty;
        CurrentPrediction = IsPredictionMode ? CreatePrediction() : null;
        if (clearFeedback)
        {
            PredictionFeedback = null;
            PredictionWasCorrect = null;
        }
    }

    private TracePrediction? CreatePrediction()
    {
        if (TraceNavigator?.CanStep != true || TraceResult is null)
        {
            return null;
        }

        return TracePredictionEvaluator.Create(
            TraceNavigator.Current,
            TraceResult.Steps[TraceNavigator.CurrentIndex + 1],
            FlowchartResult?.Graph);
    }

    private Task ToggleTracePlaybackAsync()
    {
        if (IsTracePlaying)
        {
            StopTracePlayback();
            StatusMessage = "Trace playback paused.";
            return Task.CompletedTask;
        }

        if (TraceNavigator?.CanStep != true)
        {
            return Task.CompletedTask;
        }

        TracePlaybackCancellation = new CancellationTokenSource();
        IsTracePlaying = true;
        StatusMessage = "Playing the bounded trace.";
        _ = RunTracePlaybackAsync(TracePlaybackCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RunTracePlaybackAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (TraceNavigator?.CanStep == true)
            {
                await Task.Delay(TracePlaybackDelayMilliseconds, cancellationToken);
                TraceNavigator.Step();
                StatusMessage = $"Trace step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}: {TraceNavigator.Current.ActiveNodeLabel}.";
                await SynchronizeTraceStepAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Pausing and resetting intentionally cancel the playback delay.
        }
        finally
        {
            IsTracePlaying = false;
            if (!IsDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StopTracePlayback()
    {
        TracePlaybackCancellation?.Cancel();
        TracePlaybackCancellation?.Dispose();
        TracePlaybackCancellation = null;
        IsTracePlaying = false;
    }

    private async Task SynchronizeTraceStepAsync()
    {
        if (TraceNavigator is null || FlowchartDocument is null || JavaScriptModule is null)
        {
            return;
        }

        var current = FlowchartDocument.SourceMap.FirstOrDefault(item => item.NodeId == TraceNavigator.Current.ActiveNodeId);
        if (current is null)
        {
            return;
        }

        SelectedNode = current;
        ExploredNodeIds.Add(current.NodeId);
        var previousNodeId = TraceNavigator.CurrentIndex > 0
            ? TraceResult?.Steps[TraceNavigator.CurrentIndex - 1].ActiveNodeId
            : null;
        var previous = FlowchartDocument.SourceMap.FirstOrDefault(item => item.NodeId == previousNodeId);
        var skippedTargets = previousNodeId is null || FlowchartResult?.Graph is null
            ? []
            : FlowchartResult.Graph.Edges
                .Where(edge => edge.FromNodeId == previousNodeId && edge.ToNodeId != current.NodeId)
                .Select(edge => FlowchartDocument.SourceMap.FirstOrDefault(item => item.NodeId == edge.ToNodeId)?.MermaidId)
                .Where(id => id is not null)
                .Cast<string>()
                .ToArray();

        await JavaScriptModule.InvokeVoidAsync(
            "showTraceStep",
            EditorElement,
            FlowchartContainer,
            current.MermaidId,
            current.SourceSpan?.StartOffset,
            current.SourceSpan?.Length,
            previous?.MermaidId,
            skippedTargets);
    }

    private async Task ShowSourceAsync(FlowNodeSourceMap item)
    {
        if (JavaScriptModule is null || item.SourceSpan is null)
        {
            return;
        }

        await JavaScriptModule.InvokeVoidAsync(
