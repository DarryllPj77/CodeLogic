    private async Task SelectNodeAsync(FlowNodeSourceMap item)
    {
        SelectedNode = item;
        ExploredNodeIds.Add(item.NodeId);
        NodeEditText = item.Label;
        NodeEditMessage = null;
        IsPropertiesOpen = true;
        if (item.SourceSpan is not null)
        {
            await ShowSourceAsync(item);
        }
    }

    [JSInvokable]
    public async Task SelectNodeFromBrowser(string nodeId)
    {
        var item = FlowchartDocument?.SourceMap.FirstOrDefault(candidate => candidate.NodeId == nodeId);
        if (item is not null)
        {
            await SelectNodeAsync(item);
            await InvokeAsync(StateHasChanged);
