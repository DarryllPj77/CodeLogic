@page "/playground"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ICodeAnalysisService CodeAnalysisService
@inject ICurriculumCatalog CurriculumCatalog
@inject IFlowchartTranslator FlowchartTranslator
@inject IMermaidFlowchartSerializer MermaidSerializer
@inject IPedagogicalInterpreter PedagogicalInterpreter
@inject ILogicalFeedbackService LogicalFeedbackService
@inject IJSRuntime JavaScript

<PageTitle>Playground | CodeLogic</PageTitle>

<HeadContent>
    <meta name="description" content="Edit supported C# snippets, review diagnostics, and preview a safe explanatory flowchart without compiling or executing them." />
</HeadContent>

<section class="page-header workspace-intro" aria-labelledby="playground-title">
    <p class="eyebrow">Analysis workspace</p>
    <h1 id="playground-title">C# control-flow studio</h1>
    <p>Edit supported source, inspect Roslyn diagnostics, generate a deterministic graph, and step through a bounded simulation. Nothing is compiled or run by .NET.</p>
</section>

<details class="notice notice--warning workspace-limitations">
    <summary id="editor-limitations-title">Safety model and current limitations</summary>
    <h2>Visible limitations</h2>
    <ul>
        <li>This is an accessible plain-text editor, not Visual Studio or Monaco.</li>
        <li>Code is parsed and may be interpreted by CodeLogic's small teaching model. It is never compiled or executed as a .NET program.</li>
        <li>Flowcharts support sequence, nested <code>if/else</code>, <code>while</code>, <code>for</code>, and <code>do-while</code> within the stated nesting limit.</li>
        <li><code>break</code> and <code>continue</code> are not supported yet and produce an explanation.</li>
        <li>Traces support scalar values, expressions, output, branches, and the supported loops; arrays, methods, live input, and general .NET behavior are not simulated.</li>
        <li>A trace stops after @PedagogicalInterpreter.Limits.MaximumOperations operations.</li>
        <li>The editor accepts at most @EditorState.MaximumCharacters.ToString("N0") characters.</li>
        <li>Analysis stops after @CodeAnalysisService.Limits.MaximumDuration.TotalSeconds.ToString("N0") seconds and supports at most @CodeAnalysisService.Limits.MaximumNestingDepth nested control-flow statements.</li>
        <li>Save keeps one draft only in this browser's local storage. It is not synced to your account or another device.</li>
    </ul>
</details>

<div class="workspace-toolbar" id="workspace-settings">
    <div class="workspace-file-tab"><span aria-hidden="true">#</span> Program.cs <span class="unsaved-indicator" title="Browser-local draft">●</span></div>
    <p role="status" aria-live="polite">@StatusMessage</p>
    <div class="workspace-view-actions" aria-label="Workspace view">
        <button type="button" class="icon-button" title="Split editor and flowchart" @onclick='() => WorkspaceMode = "split"'>Split</button>
        <button type="button" class="icon-button" title="Focus flowchart" @onclick='() => WorkspaceMode = "focus"'>Flowchart focus</button>
    </div>
</div>

<div class="ide-workspace ide-workspace--@WorkspaceMode">
    <nav class="workspace-rail" aria-label="Workspace panels">
        <button type="button" class="rail-button rail-button--active" title="File Explorer" aria-label="File Explorer">▱</button>
        <button type="button" class="rail-button" title="Code Structure" aria-label="Code Structure">{ }</button>
        <a class="rail-button" href="#flowchart-title" title="Flowchart Navigator" aria-label="Flowchart Navigator">◇</a>
        <a class="rail-button" href="#code-editor" title="Search source" aria-label="Search source">⌕</a>
        <a class="rail-button" href="#analysis-output" title="Diagnostics" aria-label="Diagnostics">△</a>
    </nav>

    <aside class="workspace-explorer" aria-labelledby="explorer-title">
        <div class="panel-title"><h2 id="explorer-title">Explorer</h2><span aria-hidden="true">•••</span></div>
        <p class="tree-heading">CODELOGIC WORKSPACE</p>
        <ul class="file-tree">
            <li class="file-tree__folder">⌄ Source</li>
            <li class="file-tree__file file-tree__file--active"># Program.cs</li>
            <li class="file-tree__folder">› Flow graph</li>
            <li class="file-tree__folder">› Diagnostics</li>
        </ul>
        <p class="explorer-note">Source text is the single source of truth. Diagram nodes are generated, not manually edited.</p>
    </aside>

<div class="playground-layout">
    <section class="editor-panel" aria-labelledby="editor-title">
        <div class="section-heading">
            <p class="eyebrow">Plain-text editor</p>
            <h2 id="editor-title">Edit a supported learning example</h2>
            <p>Tab moves to the next control so keyboard users are never trapped inside the editor.</p>
        </div>

        <div class="snippet-picker">
            <label for="snippet-select">Curated snippet</label>
            <select id="snippet-select" @bind="SelectedSnippetId" disabled="@(!BrowserReady)">
                @foreach (var snippet in EditorState.Snippets)
                {
                    <option value="@snippet.Id">@snippet.Title</option>
                }
            </select>
            <button class="button button--secondary" type="button" @onclick="LoadSelectedSnippet" disabled="@(!BrowserReady)">
                Load snippet
            </button>
        </div>

        <p class="snippet-description">@EditorState.ActiveSnippet.Description</p>

        <label class="editor-label" for="code-editor">C# source text</label>
        <textarea id="code-editor"
                  @ref="EditorElement"
                  class="code-editor"
                  value="@EditorState.CurrentCode"
                  @oninput="UpdateCode"
                  @onkeydown="HandleEditorKeyDown"
                  maxlength="@EditorState.MaximumCharacters"
                  rows="18"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  disabled="@(!BrowserReady)"
                  aria-describedby="editor-help editor-character-count editor-status"></textarea>

        <div class="editor-meta">
            <p id="editor-help">
                Shortcuts: <kbd>Ctrl</kbd>+<kbd>S</kbd> saves; <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>R</kbd> resets.
            </p>
            <p id="editor-character-count">@EditorState.CurrentCode.Length / @EditorState.MaximumCharacters characters</p>
        </div>

        <div class="button-row" id="editor-actions">
            <button class="button button--primary" type="button" @onclick="AnalyzeAsync" disabled="@(!BrowserReady || IsAnalyzing)">
                @(IsAnalyzing ? "Checking…" : "Check syntax")
            </button>
            <button class="button button--primary" type="button" @onclick="PreviewFlowchartAsync" disabled="@(!BrowserReady || JavaScriptModule is null || IsRendering)">
                @(IsRendering ? "Rendering…" : "Preview flowchart")
            </button>
            <button class="button button--primary" type="button" @onclick="BuildTraceAsync" disabled="@(!BrowserReady || IsTracing)">
                @(IsTracing ? "Building trace…" : "Build step trace")
            </button>
            <button class="button button--secondary" type="button" @onclick="SaveDraftAsync" disabled="@(!BrowserReady || JavaScriptModule is null)">Save browser draft</button>
            <button class="button button--secondary" type="button" @onclick="ResetDraftAsync" disabled="@(!BrowserReady)">Reset editor</button>
        </div>

        <p id="editor-status" class="editor-status">@EditorState.CurrentCode.Length / @EditorState.MaximumCharacters characters · local browser draft</p>

        @if (AnalysisResult is not null)
        {
            <section class="analysis-feedback" aria-labelledby="analysis-title" aria-live="polite">
                <h3 id="analysis-title">@AnalysisHeading(AnalysisResult.Status)</h3>
                @if (AnalysisResult.IsValid)
                {
                    <p>Roslyn understood the syntax, and every construct is inside CodeLogic's current learning subset.</p>
                    <p class="analysis-caution">This is not proof that the code compiles or produces the intended result. CodeLogic did not perform type checking or run it.</p>
                }
                else
                {
                    <ol class="analysis-diagnostic-list">
                        @foreach (var diagnostic in AnalysisResult.Diagnostics)
                        {
                            <li>
                                <p class="analysis-diagnostic-heading">
                                    <strong>@diagnostic.Code</strong>
                                    @if (diagnostic.Line is not null && diagnostic.Column is not null)
                                    {
                                        <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                                    }
                                </p>
                                <p>@diagnostic.Message</p>
                                <p class="analysis-explanation">@diagnostic.Explanation</p>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </section>

    <aside class="playground-guide properties-panel" aria-labelledby="playground-guide-title">
        <div class="panel-title"><h2 id="playground-guide-title">Node properties</h2><span aria-hidden="true">×</span></div>
        @if (SelectedNode is null)
        {
            <div class="properties-empty">
                <span aria-hidden="true">◇</span>
                <p>Select a generated node to inspect its source-backed properties.</p>
            </div>
        }
        else
        {
            <dl class="property-list">
                <div><dt>Name</dt><dd>@SelectedNode.Label</dd></div>
                <div><dt>Node type</dt><dd><span class="node-kind node-kind--@SelectedNode.NodeType.ToString().ToLowerInvariant()">@SelectedNode.NodeType</span></dd></div>
                <div><dt>Source file</dt><dd><code>Program.cs</code></dd></div>
                @if (SelectedNode.SourceSpan is not null)
                {
                    <div><dt>Source line</dt><dd>@SelectedNode.SourceSpan.StartLine:@SelectedNode.SourceSpan.StartColumn</dd></div>
                    <div><dt>Source range</dt><dd>@SelectedNode.SourceSpan.Length characters</dd></div>
                }
            </dl>
            @if (SelectedNode.SourceSpan is not null)
            {
                <button class="button button--secondary" type="button" @onclick="() => ShowSourceAsync(SelectedNode!)">Reveal in source</button>
            }
        }
    </aside>
</div>

<section class="logic-feedback-panel" aria-labelledby="logic-feedback-title" aria-live="polite">
    <div class="section-heading">
        <p class="eyebrow">Instructor-defined checks</p>
        <h2 id="logic-feedback-title">Logical mistake feedback</h2>
        <p>Try the known age exercise, then compare its output for values below, at, and above the adult boundary.</p>
    </div>

    <div class="known-exercise-card">
        <div>
            <h3>@LogicalExercise.Title</h3>
            <p>@LogicalExercise.Objective</p>
        </div>
        <div class="button-row">
            <button class="button button--secondary" type="button" @onclick="LoadLogicalExercise" disabled="@(!BrowserReady)">Load age exercise</button>
            <button class="button button--primary" type="button" @onclick="CheckLogicAsync" disabled="@(!BrowserReady || IsCheckingLogic)">
                @(IsCheckingLogic ? "Checking cases…" : "Check known cases")
            </button>
        </div>
    </div>

    @if (LogicalFeedbackResult is null)
    {
        <div class="flowchart-empty">
            <h3>No logical check yet</h3>
            <p>These checks are available only for this known exercise. They are separate from C# syntax diagnostics.</p>
        </div>
    }
    else if (!LogicalFeedbackResult.HasTestResults)
    {
        <div class="analysis-feedback" role="status">
            <h3>Fix syntax or supported-subset issues first</h3>
            <p>No logical verdict was produced. Review these analysis or exercise-setup items:</p>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in LogicalFeedbackResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else
    {
        <div class="logic-summary @(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed ? "logic-summary--passed" : "logic-summary--failed")" role="status">
            <h3>@(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed ? "All known cases passed" : "One or more known cases failed")</h3>
            <p>@(LogicalFeedbackResult.Status == LogicalFeedbackStatus.Passed
                ? "The output matched every instructor-defined case below."
                : "Compare expected and actual output, then use the hint for the failing case.")</p>
        </div>

        <div class="logic-table-wrapper">
            <table class="logic-table">
                <thead>
                    <tr>
                        <th scope="col">Case</th>
                        <th scope="col">Input</th>
                        <th scope="col">Expected</th>
                        <th scope="col">Actual</th>
                        <th scope="col">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in LogicalFeedbackResult.Tests)
                    {
                        <tr>
                            <th scope="row">
                                @test.Name
                                @if (test.IsBoundary)
                                {
                                    <span class="boundary-badge">Boundary</span>
                                }
                            </th>
                            <td><code>age = @test.Input</code></td>
                            <td><code>@test.ExpectedOutput</code></td>
                            <td><code>@test.ActualOutput</code></td>
                            <td><strong>@(test.Passed ? "Pass" : "Fail")</strong></td>
                        </tr>
                        @if (test.Hint is not null)
                        {
                            <tr class="logic-hint-row">
                                <td colspan="5"><strong>Hint:</strong> @test.Hint</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="notice notice--warning logic-limitation">
            <h3>Important limitation</h3>
            <p>@LogicalFeedbackResult.CoverageLimitation</p>
            <p>For example, code written only for ages 18 and 19 can pass these checks while still classifying age 20 incorrectly.</p>
        </div>
    }
</section>

<section class="flowchart-panel" aria-labelledby="flowchart-title" aria-live="polite">
    <div class="panel-heading-row">
        <div>
            <p class="eyebrow">Deterministic visualization</p>
            <h2 id="flowchart-title">Flowchart canvas</h2>
        </div>
        <div class="canvas-controls" aria-label="Flowchart zoom controls">
            <button type="button" class="icon-button" @onclick="() => AdjustFlowchartZoomAsync(-0.1)" aria-label="Zoom out">−</button>
            <output aria-label="Current zoom">@($"{FlowchartZoom:P0}")</output>
            <button type="button" class="icon-button" @onclick="() => AdjustFlowchartZoomAsync(0.1)" aria-label="Zoom in">+</button>
            <button type="button" class="icon-button" @onclick="FitFlowchartAsync">Fit</button>
        </div>
    </div>

    @if (FlowchartResult is null)
    {
        <div class="flowchart-empty">
            <h3>No preview yet</h3>
            <p>Choose <strong>Preview flowchart</strong> to visualize supported sequence, branching, or loop source.</p>
        </div>
    }
    else if (!FlowchartResult.IsSuccess)
    {
        <div class="analysis-feedback" role="status">
            <h3>@FlowchartHeading(FlowchartResult.Status)</h3>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in FlowchartResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else if (FlowchartDocument is not null)
    {
        @if (RendererError is not null)
        {
            <div class="notice notice--warning" role="alert">
                <h3>Diagram renderer unavailable</h3>
                <p>@RendererError</p>
                <p>The source and deterministic text map remain available below.</p>
            </div>
        }

        <div class="flowchart-canvas"
             @ref="FlowchartContainer"
             aria-label="Rendered CodeLogic flowchart"
             aria-busy="@IsRendering"></div>

        <div class="flowchart-text-map">
            <h3>Equivalent text and source map</h3>
            <p>Select a source-backed node to return to the exact text that produced it.</p>
            <ol class="flowchart-node-list">
                @foreach (var item in FlowchartDocument.SourceMap)
                {
                    <li class="@(SelectedNode?.NodeId == item.NodeId ? "source-map-item--selected" : null)">
                        <strong>@item.NodeType:</strong> @item.Label
                        <button class="text-button" type="button" @onclick="() => SelectNodeAsync(item)">
                            @(item.SourceSpan is null ? "Inspect node" : $"Show line {item.SourceSpan.StartLine}")
                        </button>
                    </li>
                }
            </ol>

            <h3>Connections</h3>
            <ul class="flowchart-edge-list">
                @foreach (var edge in FlowchartResult.Graph!.Edges)
                {
                    <li>@DescribeEdge(edge, FlowchartResult.Graph)</li>
                }
            </ul>
        </div>
    }
</section>

<section class="trace-panel bottom-panel bottom-panel--@ActiveBottomTab @(IsBottomPanelCollapsed ? "bottom-panel--collapsed" : null)" id="analysis-output" aria-labelledby="trace-title" aria-live="polite">
    <div class="bottom-tabs" role="tablist" aria-label="Output panels">
        <button type="button" class="bottom-tab @(ActiveBottomTab == "diagnostics" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "diagnostics")" @onclick='() => ActiveBottomTab = "diagnostics"'>Diagnostics <span>@(AnalysisResult?.Diagnostics.Count ?? 0)</span></button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "analysis" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "analysis")" @onclick='() => ActiveBottomTab = "analysis"'>Analysis output</button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "trace" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "trace")" @onclick='() => ActiveBottomTab = "trace"'>Execution trace</button>
        <button type="button" class="bottom-tab @(ActiveBottomTab == "terminal" ? "bottom-tab--active" : null)" role="tab" aria-selected="@(ActiveBottomTab == "terminal")" @onclick='() => ActiveBottomTab = "terminal"'>Terminal</button>
        <button type="button" class="bottom-panel-toggle" aria-expanded="@(!IsBottomPanelCollapsed)" @onclick="() => IsBottomPanelCollapsed = !IsBottomPanelCollapsed">@(IsBottomPanelCollapsed ? "Expand" : "Collapse")</button>
    </div>

    @if (ActiveBottomTab == "diagnostics")
    {
        <div class="bottom-tab-summary" role="tabpanel">
            <h2>Diagnostics</h2>
            <p>@(AnalysisResult is null ? "Run Analyze code to populate syntax and supported-subset diagnostics." : $"Analysis reported {AnalysisResult.Diagnostics.Count} diagnostic item(s). Full positioned explanations remain beside the editor.")</p>
        </div>
    }
    else if (ActiveBottomTab == "analysis")
    {
        <div class="bottom-tab-summary" role="tabpanel">
            <h2>Analysis output</h2>
            <p>@StatusMessage</p>
        </div>
    }
    else if (ActiveBottomTab == "terminal")
    {
        <div class="bottom-tab-summary terminal-safe-state" role="tabpanel">
            <h2>Terminal unavailable</h2>
            <p>CodeLogic does not expose a shell or run arbitrary .NET code. Use the bounded Execution trace for supported teaching examples.</p>
        </div>
    }

    <div class="trace-tab-content">
    <div class="section-heading">
        <p class="eyebrow">Bounded teaching model</p>
        <h2 id="trace-title">Step trace</h2>
        <p>This is CodeLogic's deterministic simulation of a small C#-shaped subset. It is not the .NET runtime and does not claim general C# behavior.</p>
    </div>

    @if (TraceResult is null)
    {
        <div class="flowchart-empty">
            <h3>No trace yet</h3>
            <p>Choose <strong>Build step trace</strong> to inspect the program counter, active graph node, variables, and simulated output.</p>
        </div>
    }
    else if (!TraceResult.HasTrace)
    {
        <div class="analysis-feedback" role="status">
            <h3>@TraceHeading(TraceResult.Status)</h3>
            <ol class="analysis-diagnostic-list">
                @foreach (var diagnostic in TraceResult.Diagnostics)
                {
                    <li>
                        <p class="analysis-diagnostic-heading">
                            <strong>@diagnostic.Code</strong>
                            @if (diagnostic.Line is not null && diagnostic.Column is not null)
                            {
                                <span>Line @diagnostic.Line, column @diagnostic.Column</span>
                            }
                        </p>
                        <p>@diagnostic.Message</p>
                        <p class="analysis-explanation">@diagnostic.Explanation</p>
                    </li>
                }
            </ol>
        </div>
    }
    else if (TraceNavigator is not null)
    {
        @if (TraceResult.Status == ExecutionTraceStatus.StepLimitReached)
        {
            <div class="notice notice--warning" role="status">
                <h3>Operation limit reached</h3>
                <p>@TraceResult.Diagnostics[0].Message @TraceResult.Diagnostics[0].Explanation</p>
            </div>
        }

        <div class="trace-controls">
            <p><strong>Trace step @TraceNavigator.StepNumber of @TraceNavigator.StepCount</strong></p>
            <div class="button-row">
                <button class="button button--primary" type="button" @onclick="NextTraceStep" disabled="@(!TraceNavigator.CanStep)">Next step</button>
                <button class="button button--secondary" type="button" @onclick="ResetTrace">Reset trace</button>
            </div>
        </div>

        <div class="trace-state">
            <section aria-labelledby="trace-operation-title">
                <h3 id="trace-operation-title">Active operation</h3>
                <dl class="trace-details">
                    <div><dt>Program counter</dt><dd>@TraceNavigator.Current.ProgramCounter</dd></div>
                    <div><dt>Graph node</dt><dd><code>@TraceNavigator.Current.ActiveNodeId</code> · @TraceNavigator.Current.ActiveNodeType</dd></div>
                    <div><dt>Source meaning</dt><dd>@TraceNavigator.Current.ActiveNodeLabel</dd></div>
                </dl>
                <p>@TraceNavigator.Current.Explanation</p>
            </section>

            <section aria-labelledby="trace-variables-title">
                <h3 id="trace-variables-title">Variables</h3>
                @if (TraceNavigator.Current.Variables.Count == 0)
                {
                    <p>No variables have values yet.</p>
                }
                else
                {
                    <table class="trace-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
                        <tbody>
                            @foreach (var variable in TraceNavigator.Current.Variables)
                            {
                                <tr><th scope="row"><code>@variable.Key</code></th><td><code>@variable.Value</code></td></tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section aria-labelledby="trace-output-title">
                <h3 id="trace-output-title">Simulated output</h3>
                @if (TraceNavigator.Current.Output.Count == 0)
                {
                    <p>No output has been added yet.</p>
                }
                else
                {
                    <pre class="trace-output">@string.Join(Environment.NewLine, TraceNavigator.Current.Output)</pre>
                }
            </section>
        </div>
    }
    </div>
</section>
</div>

@code {
    private const string DraftStorageKey = "CodeLogic.Playground.Draft.v1";
    private static LogicalExerciseSpecification LogicalExercise => KnownLogicalExercises.AgeBoundary;
    private PlaygroundEditorState EditorState { get; set; } = null!;
    private string SelectedSnippetId { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = "Preparing browser draft storage.";
    private bool BrowserReady { get; set; }
    private bool IsAnalyzing { get; set; }
    private bool IsRendering { get; set; }
    private bool IsTracing { get; set; }
    private bool IsCheckingLogic { get; set; }
    private bool RenderPending { get; set; }
    private CodeAnalysisResult? AnalysisResult { get; set; }
    private FlowchartTranslationResult? FlowchartResult { get; set; }
    private MermaidFlowchartDocument? FlowchartDocument { get; set; }
    private string? RendererError { get; set; }
    private ExecutionTraceResult? TraceResult { get; set; }
    private ExecutionTraceNavigator? TraceNavigator { get; set; }
    private LogicalFeedbackResult? LogicalFeedbackResult { get; set; }
    private int RenderSequence { get; set; }
    private double FlowchartZoom { get; set; } = 1;
    private string WorkspaceMode { get; set; } = "split";
    private string ActiveBottomTab { get; set; } = "trace";
    private bool IsBottomPanelCollapsed { get; set; }
    private FlowNodeSourceMap? SelectedNode { get; set; }
    private ElementReference EditorElement { get; set; }
    private ElementReference FlowchartContainer { get; set; }
    private IJSObjectReference? JavaScriptModule { get; set; }

    protected override void OnInitialized()
    {
        var manifest = CurriculumCatalog.GetManifest();
        var snippets = manifest.Lessons
            .Where(lesson => lesson.Status == CurriculumLessonStatus.Complete)
            .Select(lesson => new PlaygroundSnippet(
                lesson.Lesson.Id.ToString(),
                lesson.Lesson.Title,
                lesson.Lesson.Objective,
                lesson.SampleCode));

        EditorState = new PlaygroundEditorState(
            snippets,
            manifest.SafeSnippetPolicy.MaximumCharacters);
        SelectedSnippetId = EditorState.ActiveSnippet.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                JavaScriptModule = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/playground.js");
                await JavaScriptModule.InvokeVoidAsync(
                    "initializeEditorShortcuts",
                    EditorElement);
                var savedDraft = await JavaScriptModule.InvokeAsync<string?>(
                    "loadDraft",
                    DraftStorageKey);

                if (savedDraft is not null)
                {
                    if (EditorState.TryUpdateCode(savedDraft))
                    {
                        EditorState.MarkSaved();
                        StatusMessage = "Saved browser draft restored.";
                    }
                    else
                    {
                        await JavaScriptModule.InvokeVoidAsync("clearDraft", DraftStorageKey);
                        StatusMessage = "An oversized saved draft was discarded. The curated snippet remains loaded.";
                    }
                }
                else
                {
                    StatusMessage = "The current snippet has not been saved in this browser.";
                }
            }
            catch (JSException)
            {
                StatusMessage = "Browser features are unavailable. Editing and reset still work, but save and diagram rendering are disabled.";
            }
            finally
            {
                BrowserReady = true;
                StateHasChanged();
            }
        }

        if (RenderPending && JavaScriptModule is not null && FlowchartDocument is not null)
        {
            RenderPending = false;
            try
            {
                await JavaScriptModule.InvokeVoidAsync(
                    "renderMermaid",
                    FlowchartContainer,
                    FlowchartDocument.Definition,
                    $"codelogic-flowchart-{++RenderSequence}");
                StatusMessage = "Flowchart preview rendered. Nothing was compiled or executed.";
            }
            catch (JSException)
            {
                RendererError = "Mermaid could not render this preview. Check the browser connection and try again.";
                StatusMessage = "The visual renderer failed; the equivalent text map is still available.";
            }
            finally
            {
                IsRendering = false;
                StateHasChanged();
            }
        }
    }

    private void UpdateCode(ChangeEventArgs eventArgs)
    {
        AnalysisResult = null;
        ClearFlowchart();
        var code = eventArgs.Value?.ToString() ?? string.Empty;
        StatusMessage = EditorState.TryUpdateCode(code)
            ? "Unsaved changes."
            : $"The editor limit is {EditorState.MaximumCharacters:N0} characters.";
    }

    private void LoadSelectedSnippet()
    {
        AnalysisResult = null;
        ClearFlowchart();
        EditorState.LoadSnippet(SelectedSnippetId);
        StatusMessage = $"Loaded {EditorState.ActiveSnippet.Title}. Save to keep it as your browser draft.";
    }

    private async Task SaveDraftAsync()
    {
        if (JavaScriptModule is null)
        {
            StatusMessage = "Browser storage is unavailable, so this draft was not saved.";
            return;
        }

        try
        {
            await JavaScriptModule.InvokeVoidAsync(
                "saveDraft",
                DraftStorageKey,
                EditorState.CurrentCode);
            EditorState.MarkSaved();
            StatusMessage = "Draft saved in this browser.";
        }
        catch (JSException)
        {
            StatusMessage = "The browser refused local storage, so this draft was not saved.";
        }
    }

    private async Task ResetDraftAsync()
    {
        AnalysisResult = null;
        ClearFlowchart();
        EditorState.Reset();
        if (JavaScriptModule is not null)
        {
            try
            {
                await JavaScriptModule.InvokeVoidAsync("clearDraft", DraftStorageKey);
            }
            catch (JSException)
            {
                StatusMessage = "The editor reset, but the browser's saved draft could not be cleared.";
                return;
            }
        }

        StatusMessage = $"Editor reset to {EditorState.ActiveSnippet.Title}; the browser draft was cleared.";
    }

    private async Task AnalyzeAsync()
    {
        IsAnalyzing = true;
        StatusMessage = "Checking syntax and the supported learning subset.";
        try
        {
            AnalysisResult = await CodeAnalysisService.AnalyzeAsync(EditorState.CurrentCode);
            StatusMessage = AnalysisResult.IsValid
                ? "Syntax and supported-subset check passed. Nothing was compiled or run."
                : $"Analysis found {AnalysisResult.Diagnostics.Count} item(s) to review.";
        }
        finally
        {
            IsAnalyzing = false;
        }
    }

    private async Task PreviewFlowchartAsync()
    {
        IsRendering = true;
        RendererError = null;
        FlowchartDocument = null;
        StatusMessage = "Building a deterministic flowchart from supported syntax.";

        FlowchartResult = await FlowchartTranslator.TranslateAsync(EditorState.CurrentCode);
        if (!FlowchartResult.IsSuccess)
        {
            IsRendering = false;
            StatusMessage = $"Flowchart translation found {FlowchartResult.Diagnostics.Count} item(s) to review.";
            return;
        }

        FlowchartDocument = MermaidSerializer.Serialize(FlowchartResult.Graph!);
        SelectedNode = FlowchartDocument.SourceMap.FirstOrDefault();
        FlowchartZoom = 1;
        RenderPending = true;
        StatusMessage = "The graph is ready; rendering the browser preview.";
    }

    private async Task BuildTraceAsync()
    {
        IsTracing = true;
        TraceNavigator = null;
        StatusMessage = "Building a bounded teaching trace. No .NET program is being run.";
        try
        {
            TraceResult = await PedagogicalInterpreter.TraceAsync(EditorState.CurrentCode);
            if (TraceResult.HasTrace)
            {
                TraceNavigator = new ExecutionTraceNavigator(TraceResult);
                StatusMessage = TraceResult.Status == ExecutionTraceStatus.StepLimitReached
                    ? $"Trace stopped safely at the {TraceResult.MaximumOperations}-operation limit."
                    : $"Trace built with {TraceResult.Steps.Count} snapshots. Use Next step to inspect it.";
            }
            else
            {
                StatusMessage = $"Trace simulation found {TraceResult.Diagnostics.Count} item(s) to review.";
            }
        }
        finally
        {
            IsTracing = false;
        }
    }

    private void LoadLogicalExercise()
    {
        AnalysisResult = null;
        ClearFlowchart();
        if (!EditorState.TryUpdateCode(LogicalExercise.StarterCode))
        {
            StatusMessage = "The known exercise exceeds the editor limit and could not be loaded.";
            return;
        }

        StatusMessage = "Loaded the Adult age boundary exercise. Change its comparison, then check the known cases.";
    }

    private async Task CheckLogicAsync()
    {
        IsCheckingLogic = true;
        StatusMessage = "Checking three instructor-defined age cases with the bounded interpreter.";
        try
        {
            LogicalFeedbackResult = await LogicalFeedbackService.EvaluateAsync(
                LogicalExercise,
                EditorState.CurrentCode);
            StatusMessage = LogicalFeedbackResult.Status switch
            {
                LogicalFeedbackStatus.Passed => "All three known age cases passed; untested ages may still reveal a mistake.",
                LogicalFeedbackStatus.Failed => "A known age case failed. Compare expected and actual output below.",
                _ => "Logic was not checked because syntax, support, or exercise setup needs attention first.",
            };
        }
        finally
        {
            IsCheckingLogic = false;
        }
    }

    private void NextTraceStep()
    {
        TraceNavigator?.Step();
        if (TraceNavigator is not null)
        {
            StatusMessage = $"Trace step {TraceNavigator.StepNumber} of {TraceNavigator.StepCount}: {TraceNavigator.Current.ActiveNodeLabel}.";
        }
    }

    private void ResetTrace()
    {
        TraceNavigator?.Reset();
        StatusMessage = "Trace reset to its initial state.";
    }

    private async Task ShowSourceAsync(FlowNodeSourceMap item)
    {
        if (JavaScriptModule is null || item.SourceSpan is null)
        {
            return;
        }

        await JavaScriptModule.InvokeVoidAsync(
            "selectSource",
            EditorElement,
            FlowchartContainer,
            item.MermaidId,
            item.SourceSpan.StartOffset,
            item.SourceSpan.Length);
        StatusMessage = $"Selected source for {item.NodeType} on line {item.SourceSpan.StartLine}.";
    }

    private async Task SelectNodeAsync(FlowNodeSourceMap item)
    {
        SelectedNode = item;
        if (item.SourceSpan is not null)
        {
            await ShowSourceAsync(item);
        }
    }

    private async Task AdjustFlowchartZoomAsync(double change)
    {
        FlowchartZoom = Math.Clamp(FlowchartZoom + change, 0.5, 2);
        if (JavaScriptModule is not null)
        {
            await JavaScriptModule.InvokeVoidAsync("setFlowchartZoom", FlowchartContainer, FlowchartZoom);
        }
    }

    private async Task FitFlowchartAsync()
    {
        FlowchartZoom = 1;
        if (JavaScriptModule is not null)
        {
            await JavaScriptModule.InvokeVoidAsync("fitFlowchart", FlowchartContainer);
        }
    }

    private void ClearFlowchart()
    {
        FlowchartResult = null;
        FlowchartDocument = null;
        SelectedNode = null;
        FlowchartZoom = 1;
        RendererError = null;
        RenderPending = false;
        IsRendering = false;
        TraceResult = null;
        TraceNavigator = null;
        IsTracing = false;
        LogicalFeedbackResult = null;
        IsCheckingLogic = false;
    }

    private static string AnalysisHeading(CodeAnalysisStatus status) => status switch
    {
        CodeAnalysisStatus.Valid => "Syntax and supported subset check passed",
        CodeAnalysisStatus.InvalidInput => "Enter a short C# snippet",
        CodeAnalysisStatus.SyntaxError => "Fix the C# syntax",
        CodeAnalysisStatus.Unsupported => "Valid syntax, unsupported CodeLogic feature",
        CodeAnalysisStatus.TimedOut => "Analysis stopped at the time limit",
        _ => "Analysis result",
    };

    private static string FlowchartHeading(FlowchartTranslationStatus status) => status switch
    {
        FlowchartTranslationStatus.InvalidInput => "Enter a short C# snippet",
        FlowchartTranslationStatus.SyntaxError => "Fix the C# syntax before previewing",
        FlowchartTranslationStatus.Unsupported => "This syntax is not in the flowchart subset",
        FlowchartTranslationStatus.TimedOut => "Flowchart analysis stopped at the time limit",
        _ => "Flowchart unavailable",
    };

    private static string TraceHeading(ExecutionTraceStatus status) => status switch
    {
        ExecutionTraceStatus.InvalidInput => "Enter a short C# snippet",
        ExecutionTraceStatus.SyntaxError => "Fix the C# syntax before tracing",
        ExecutionTraceStatus.Unsupported => "This syntax is not in the trace subset",
        ExecutionTraceStatus.TimedOut => "Trace analysis stopped at the time limit",
        _ => "Trace unavailable",
    };

    private static string DescribeEdge(FlowEdge edge, FlowGraph graph)
    {
        var from = graph.Nodes.Single(node => node.Id == edge.FromNodeId);
        var to = graph.Nodes.Single(node => node.Id == edge.ToNodeId);
        var path = edge.Type switch
        {
            FlowEdgeType.True => "True path",
            FlowEdgeType.False => "False path",
            FlowEdgeType.LoopBack => edge.Label ?? "Repeat path",
            _ => "Next",
        };
        return $"{path}: {from.Label} → {to.Label}";
    }

    private Task HandleEditorKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.CtrlKey && !eventArgs.AltKey && !eventArgs.ShiftKey
            && string.Equals(eventArgs.Key, "s", StringComparison.OrdinalIgnoreCase))
        {
            return SaveDraftAsync();
        }

        if (eventArgs.CtrlKey && eventArgs.AltKey && !eventArgs.ShiftKey
            && string.Equals(eventArgs.Key, "r", StringComparison.OrdinalIgnoreCase))
        {
            return ResetDraftAsync();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (JavaScriptModule is not null)
        {
            try
            {
                await JavaScriptModule.InvokeVoidAsync("disposeEditorShortcuts", EditorElement);
                await JavaScriptModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected; no client resource remains to release.
            }
        }
    }
}
