    private static string DescribeEdge(FlowEdge edge, FlowGraph graph)
    {
        var from = graph.Nodes.Single(node => node.Id == edge.FromNodeId);
        var to = graph.Nodes.Single(node => node.Id == edge.ToNodeId);
        var loopDecision = graph.Edges.Any(candidate =>
            candidate.Type == FlowEdgeType.LoopBack && candidate.ToNodeId == edge.FromNodeId);
        var path = edge.Type switch
        {
            FlowEdgeType.True when loopDecision => "Loop path",
            FlowEdgeType.False when loopDecision => "Exit path",
            FlowEdgeType.True => "True path",
            FlowEdgeType.False => "False path",
            FlowEdgeType.LoopBack => edge.Label ?? "Loop path",
            _ => "Next",
        };
        return $"{path}: {from.Label} → {to.Label}";
    }

    private async Task UpdateEditorStructureAsync(string source, CancellationToken cancellationToken)
    {
        var regions = await EditorStructureService.GetFoldRegionsAsync(source, cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        EditorFoldRegions = regions;
        if (JavaScriptModule is null)
        {
            return;
        }

        try
        {
            await JavaScriptModule.InvokeVoidAsync(
                "updateFoldRegions",
                cancellationToken,
                EditorElement,
                regions);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            // Folding is a convenience; the editor keeps its previous fold ranges.
        }
    }

    // Outlines flowchart nodes whose source lines have analysis diagnostics. The JS call clears
    // stale outlines, so passing an empty list is how markers are removed.
    private async Task MarkFlowchartDiagnosticsAsync()
    {
        if (JavaScriptModule is null || FlowchartDocument is null)
        {
            return;
        }

        var lines = AnalysisResult?.Diagnostics
            .Where(diagnostic => diagnostic.Line is not null)
            .Select(diagnostic => diagnostic.Line!.Value)
            .Distinct()
            .ToArray() ?? [];
        try
        {
            await JavaScriptModule.InvokeVoidAsync(
                "markFlowchartErrors",
                FlowchartContainer,
                FlowchartDocument.SourceMap,
                lines);
        }
        catch (JSException)
        {
            // Markers are supplementary; the Diagnostics tab still lists every item as text.
        }
    }

    private Task SynchronizeEditorValueAsync() => JavaScriptModule is null
        ? Task.CompletedTask
        : JavaScriptModule.InvokeVoidAsync("setEditorValue", EditorElement, EditorState.CurrentCode).AsTask();

    public async ValueTask DisposeAsync()
    {
        IsDisposed = true;
        StopTracePlayback();
        FlowchartDebouncer.Dispose();
        StructureDebouncer.Dispose();
        if (JavaScriptModule is not null)
        {
            try
            {
                await JavaScriptModule.InvokeVoidAsync("disposeCodeEditor", EditorElement);
                await JavaScriptModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected; no client resource remains to release.
            }
        }

        if (WorkspaceModule is not null)
        {
            try
            {
                await WorkspaceModule.InvokeVoidAsync("disposeWorkspace", WorkspaceRoot);
                await WorkspaceModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected; no client resource remains to release.
            }
        }

        ComponentReference?.Dispose();
    }
}
