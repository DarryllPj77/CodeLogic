    private async Task ApplyNodeEditAsync()
    {
        if (SelectedNode?.SourceSpan is null)
        {
            NodeEditMessage = "Select a source-backed node before editing.";
            return;
        }

        if (!SourceMappedSourceEditor.TryReplace(
            EditorState.CurrentCode,
            SelectedNode.SourceSpan,
            NodeEditText,
            EditorState.MaximumCharacters,
            out var candidate,
            out var error))
        {
            NodeEditMessage = error;
            ShowToast(error, "warning");
            return;
        }

        var result = await FlowchartTranslator.TranslateAsync(candidate);
        if (!result.IsSuccess)
        {
            var diagnostic = result.Diagnostics.FirstOrDefault();
            NodeEditMessage = diagnostic is null
                ? "The edit is not supported by CodeLogic."
                : $"{diagnostic.Code}: {diagnostic.Message}";
            ShowToast("Node edit rejected; the source was not changed.", "warning");
            return;
        }

        if (!EditorState.TryUpdateCode(candidate))
        {
            NodeEditMessage = "The edited source exceeds the editor limit.";
            return;
        }

        ApplyValidFlowchart(result, "Node edit applied to the mapped source statement.");
        await SynchronizeEditorValueAsync();
        NodeEditMessage = "Edit accepted. The editor and flowchart now use the updated statement.";
        ShowToast("Node edit applied safely.");
    }

