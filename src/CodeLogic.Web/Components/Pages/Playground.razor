    private string? BranchTarget(FlowEdgeType edgeType)
    {
        if (SelectedNode is null || FlowchartResult?.Graph is null)
        {
            return null;
        }

        var edge = FlowchartResult.Graph.Edges.FirstOrDefault(candidate =>
            candidate.FromNodeId == SelectedNode.NodeId && candidate.Type == edgeType);
        return edge is null
            ? null
            : FlowchartResult.Graph.Nodes.FirstOrDefault(node => node.Id == edge.ToNodeId)?.Label;
    }

    private void ShowToast(string message, string kind = "success")
    {
        ToastMessage = message;
        ToastKind = kind;
        var version = ++ToastVersion;
        _ = DismissToastLaterAsync(version);
    }

    private async Task DismissToastLaterAsync(int version)
    {
        await Task.Delay(TimeSpan.FromSeconds(4));
        if (!IsDisposed && version == ToastVersion)
        {
            await InvokeAsync(DismissToast);
        }
    }

    private void DismissToast()
    {
        ToastMessage = null;
        ToastVersion++;
    }

    private void ClearFlowchart()
    {
        FlowchartDebouncer.Cancel();
        StopTracePlayback();
        FlowchartResult = null;
        FlowchartDocument = null;
        LiveFlowchartFailure = null;
        SelectedNode = null;
        ExploredNodeIds.Clear();
        FlowchartZoom = 1;
        RendererError = null;
        RenderPending = false;
        IsRendering = false;
        TraceResult = null;
        TraceNavigator = null;
        PreparePrediction(clearFeedback: true);
        IsTracing = false;
        LogicalFeedbackResult = null;
        IsCheckingLogic = false;
    }

    private void ClearTraceAndFeedback()
