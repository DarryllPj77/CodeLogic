@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | CodeLogic</PageTitle>

<section class="empty-state" aria-labelledby="not-found-title">
    <div class="empty-state__mark" aria-hidden="true">?</div>
    <div>
        <p class="eyebrow">404 · Page not found</p>
        <h1 id="not-found-title">That learning path is not here.</h1>
        <p>The address may be incorrect, or the page may belong to a later CodeLogic task.</p>
        <a class="button button--primary" href="/">Return home</a>
    </div>
</section>
