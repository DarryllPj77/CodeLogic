@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <PageTitle>Access denied | CodeLogic</PageTitle>
        <section class="empty-state" aria-labelledby="route-access-denied-title">
            <div class="empty-state__mark" aria-hidden="true">!</div>
            <div>
                <p class="eyebrow">Access denied</p>
                <h1 id="route-access-denied-title">This account cannot access that page</h1>
                <p>The page requires permissions that are not assigned to this account.</p>
                <a class="button button--primary" href="/">Return home</a>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <PageTitle>Sign in required | CodeLogic</PageTitle>
        <section class="empty-state" aria-labelledby="sign-in-required-title">
            <div class="empty-state__mark" aria-hidden="true">!</div>
            <div>
                <p class="eyebrow">Account required</p>
                <h1 id="sign-in-required-title">Sign in to view this page</h1>
                <p>Lessons are open to everyone. An account is required only when work needs to be saved or protected.</p>
                <div class="button-row">
                    <a class="button button--primary" href="@LoginUrl">Sign in</a>
                    <a class="button button--secondary" href="@RegisterUrl">Create account</a>
                </div>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string ReturnPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    private string LoginUrl => $"/account/login?returnUrl={Uri.EscapeDataString(ReturnPath)}";

    private string RegisterUrl => $"/account/register?returnUrl={Uri.EscapeDataString(ReturnPath)}";
}
